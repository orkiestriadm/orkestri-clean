+"use client";
+
+import { useState } from "react";
+import { ArrowRight, CalendarDays, CheckCheck, MessageCircle } from "lucide-react";
+import { Container } from "@/components/ui/container";
+
+const steps = [
+  { title: "Comece a conversa", description: "O botão abre o WhatsApp com o comando do teste pronto para enviar.", user: "CADASTRO AGENDA", reply: "Vamos começar seu cadastro para testar a agenda por 7 dias. Qual é o seu nome completo?", note: "A Aurélia pede nome, CPF, e-mail e empresa. Para uso pessoal, informe Pessoal." },
+  { title: "Confira seus dados", description: "Responda às perguntas e confirme os dados na própria conversa.", user: "Confirmo meus dados.", reply: "Seu teste da agenda está pronto. Envie começar para receber as orientações do primeiro compromisso.", note: "O teste começa após a criação da conta. Sem cartão e sem cobrança automática." },
+  { title: "Organize seu primeiro dia", description: "A Aurélia guia você para registrar e confirmar um compromisso.", user: "começar", reply: "Vamos registrar seu primeiro compromisso? Escolha 1 — compromisso e informe o título, o dia e o horário. Você confere a prévia antes de salvar.", note: "Para consultar os eventos, envie compromissos. Para rever as instruções de acesso, envie acesso." },
+];
+
+/** Demonstração local: não envia mensagens nem cria cadastros. */
+export function AureliaDemo() {
+  const [active, setActive] = useState(0);
+  const step = steps[active];
+  return (
+    <section id="como-funciona" className="relative scroll-mt-24 overflow-hidden bg-ink-raise py-20 md:py-28">
+      <Container>
+        <div className="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
+          <div>
+            <span className="text-sm font-medium text-flame-soft">Conheça a Aurélia</span>
+            <h2 className="mt-4 font-display text-[2rem] font-bold leading-tight text-chalk md:text-[2.75rem]">Da primeira mensagem ao primeiro compromisso.</h2>
+            <p className="mt-5 max-w-lg leading-relaxed text-chalk-dim">Seu cadastro acontece na conversa. Veja uma demonstração das etapas para começar a usar a agenda.</p>
+            <div className="mt-8 flex flex-col gap-3" aria-label="Etapas da demonstração">
+              {steps.map((item, index) => (
+                <button key={item.title} type="button" aria-pressed={active === index} aria-controls="aurelia-preview" onClick={() => setActive(index)} className={`journey-step flex min-h-20 items-start gap-4 rounded-2xl border p-4 text-left ${active === index ? "border-flame/50 bg-flame/[0.07]" : "border-white/[0.08] bg-panel hover:border-white/25"}`}>
+                  <span className={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-sm ${active === index ? "bg-flame text-ink" : "bg-white/[0.06] text-chalk-faint"}`}>{index + 1}</span>
+                  <span><span className="block font-semibold text-chalk">{item.title}</span><span className="mt-1 block text-sm leading-relaxed text-chalk-dim">{item.description}</span></span>
+                  <ArrowRight className="ml-auto mt-2 h-4 w-4 shrink-0 text-flame-soft" aria-hidden />
+                </button>
+              ))}
+            </div>
+          </div>
+          <div className="relative min-w-0">
+            <div aria-hidden className="pointer-events-none absolute -inset-6 rounded-full bg-flame/[0.08] blur-3xl" />
+            <div className="relative overflow-hidden rounded-[28px] border border-white/15 bg-panel shadow-2xl">
+              <div className="flex items-center gap-3 border-b border-white/10 p-5">
+                <span className="flex h-11 w-11 items-center justify-center rounded-2xl bg-flame/15 text-flame-soft"><MessageCircle className="h-6 w-6" aria-hidden /></span>
+                <div><p className="font-semibold text-chalk">Aurélia</p><p className="text-xs text-chalk-faint">Assistente do Orkiestri · demonstração</p></div>
+              </div>
+              <div id="aurelia-preview" aria-live="polite" aria-atomic="true" className="chat-grid min-h-[350px] space-y-6 p-5 sm:p-7">
+                <div key={`user-${active}`} className="chat-enter ml-6 rounded-2xl rounded-tr-sm border border-white/10 bg-white/[0.07] p-4">
+                  <p className="mb-2 text-xs text-chalk-faint">Você</p><p className="text-sm leading-relaxed text-chalk">{step.user}</p><CheckCheck className="ml-auto mt-2 h-4 w-4 text-flame-soft" aria-hidden />
+                </div>
+                <div key={`reply-${active}`} className="chat-enter mr-4 rounded-2xl rounded-tl-sm border border-flame/20 bg-ink-raise p-4">
+                  <p className="mb-2 text-xs font-medium text-flame-soft">Aurélia</p><p className="text-sm leading-relaxed text-chalk">{step.reply}</p>
+                </div>
+                <p className="text-xs leading-relaxed text-chalk-dim">{step.note}</p>
+              </div>
+              <div className="flex items-center gap-2 border-t border-white/10 px-5 py-4 text-xs text-chalk-faint"><CalendarDays className="h-4 w-4 shrink-0" aria-hidden /> Exemplo ilustrativo. Inicie seu cadastro no WhatsApp.</div>
+            </div>
+          </div>
+        </div>
+      </Container>
+    </section>
+  );
+}

