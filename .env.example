# Database
POSTGRES_DB=orkestri
POSTGRES_USER=orkestri
POSTGRES_PASSWORD=change_me

# Redis
REDIS_PASSWORD=change_me

# JWT
JWT_SECRET=change_me_long_random_string
JWT_REFRESH_SECRET=change_me_long_random_string

# App
APP_URL=http://localhost
CORS_ORIGINS=http://localhost,http://localhost:80

# Master user (created on first boot)
MASTER_EMAIL=sa@yourcompany.local
MASTER_PASSWORD=change_me
MASTER_NOME=SA

# Evolution API (WhatsApp)
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=change_me

# Email (Resend — resend.com)
RESEND_API_KEY=change_me
EMAIL_FROM=noreply@seudominio.com.br
EMAIL_FROM_NAME=Orkestri

# Cofre de segredos (cifra tokens de integração no banco). 64 hex OU frase longa.
# Já é exigido pelo módulo OSA. Sem ele, a conexão Microsoft recusa guardar tokens.
APP_VAULT_KEY=change_me_64_hex_or_long_passphrase

# ── Monitoramento OSA — Zabbix + cruzamento com o N1 (MTP_LISTAG) ──────────────
# Zabbix: alimenta os cards "Via Zabbix" (último .tag processado por servidor).
# Enquanto vazios, a seção Zabbix simplesmente não aparece (o resto segue normal).
ZABBIX_API_URL=
ZABBIX_API_TOKEN=
# N1 (SGA_N1): sequencial ESPERADO por OSA, lido da MTP_LISTAG. Preenche o bloco
# "Esperado (N1) × Atraso" AO VIVO em cada card. Sem N1_DB_HOST o bloco não renderiza
# e a única comparação disponível fica sendo o painel manual "Consultar Sequencial".
# Use o mesmo N1 autoritativo do operacional (atenção: NÃO uma réplica que possa congelar).
N1_DB_HOST=
N1_DB_PORT=3306
N1_DB_USER=
N1_DB_PASS=
N1_DB_NAME=SGA_N1

# ── Integração Microsoft 365 / Outlook Calendar (Microsoft Graph) ──────────────
# Valores do App Registration no Microsoft Entra. Ver docs/integracoes/MICROSOFT_365_SETUP.md.
# Enquanto vazios, a integração fica desativada (o resto do sistema segue normal).
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Directory (tenant) ID, ou "common" para multitenant.
MS_TENANT_ID=common
# URL pública HTTPS do Orkiestri (para redirect do OAuth e webhook do Graph).
# Cai para APP_URL se não informado. O webhook exige HTTPS público (não localhost).
MS_APP_URL=
# Opcionais — sobrescrevem os padrões derivados de MS_APP_URL:
# MS_REDIRECT_URI=https://seu-dominio/api/integracoes/microsoft/callback
# MS_WEBHOOK_URL=https://seu-dominio/api/integracoes/microsoft/webhook
