generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────

enum ProjectStatus {
  PLANEJAMENTO
  EM_ANDAMENTO
  PAUSADO
  CONCLUIDO
  CANCELADO
}

enum Priority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum TaskStatus {
  A_FAZER
  EM_ANDAMENTO
  EM_REVISAO
  CONCLUIDA
  CANCELADA
}

enum EventType {
  PESSOAL
  REUNIAO
  PROJETO
  EXTERNO
  COMPROMISSO
  LEMBRETE
}

enum NoteType {
  TEXTO
  CHECKLIST
}

enum Recurrence {
  DIARIA
  SEMANAL
  QUINZENAL
  MENSAL
}

enum ProjectTipo {
  PROJETO
  NEGOCIO
}

// ── Multi-tenancy ──────────────────────────────────────────────────────────────

model Organization {
  id                String   @id @default(uuid())
  nome              String
  slug              String   @unique
  plano             String   @default("starter")
  ativo             Boolean  @default(true)
  // Cadastro da empresa
  cnpj              String?
  nomeFantasia      String?  @map("nome_fantasia")
  segmento          String?
  site              String?
  emailContato      String?  @map("email_contato")
  telefone          String?
  responsavelNome   String?  @map("responsavel_nome")
  cep               String?
  endereco          String?
  cidade            String?
  estado            String?
  observacoes       String?
  // CRM ↔ Tenant link
  crmClienteId      String?  @unique @map("crm_cliente_id")
  statusComercial   String?  @map("status_comercial")
  statusOperacional String?  @map("status_operacional")
  modulosAtivos     String[] @default([]) @map("modulos_ativos")
  criadoEm          DateTime @default(now()) @map("criado_em")
  atualizadoEm      DateTime @updatedAt @map("atualizado_em")

  users                   User[]
  roles                   Role[]
  chamados                Chamado[]
  clientes                Cliente[]
  contratos               Contrato[]
  faturas                 Fatura[]
  projetos                Project[]
  notas                   Note[]
  noteLabels              NoteLabel[]
  eventos                 Event[]
  calendarConnections     CalendarConnection[]
  calendarProviderConfigs CalendarProviderConfig[]
  automacoes              Automacao[]
  alertaRegras            AlertaRegra[]
  ativos                  Ativo[]
  categoriasAtivo         CategoriaAtivo[]
  artigos                 ArtigoConhecimento[]
  categoriasConhec        CategoriaConhecimento[]
  suppliers               Supplier[]
  slaRegras               SlaRegra[]
  alertConfigs            AlertConfig[]
  setores                 Setor[]
  auditLogs               AuditLog[]
  orcamentoCiclos         OrcamentoCiclo[]
  centrosCusto            CentroCusto[]
  categoriasOrc           CategoriaOrcamento[]
  fornecedoresOrc         FornecedorOrcamento[]
  sistemaConfigs          SistemaConfig[]
  apontamentosHoras       ApontamentoHoras[]
  whatsappConfig          OrgWhatsappConfig?
  cadastroRequests        CadastroRequest[]            @relation("CadReqOrg")
  collaborators           Collaborator[]               @relation("OrgCollaborators")
  positions               Position[]                   @relation("OrgPositions")
  careerTracks            CareerTrack[]                @relation("OrgCareerTracks")
  checklistModelos        ChecklistTemplate[]          @relation("OrgChecklistTemplates")
  checklistItens          ChecklistTemplateItem[]      @relation("OrgChecklistTemplateItems")
  checklists              CollaboratorChecklist[]      @relation("OrgCollaboratorChecklists")
  checklistItensCol       CollaboratorChecklistItem[]  @relation("OrgCollaboratorChecklistItems")
  careerSteps             CareerTrackStep[]            @relation("OrgCareerSteps")
  careerRequisitos        CareerStepRequirement[]      @relation("OrgCareerRequirements")
  collabHistory           CollaboratorHistory[]        @relation("OrgCollaboratorHistory")
  collabDocuments         CollaboratorDocument[]       @relation("OrgCollaboratorDocuments")
  vacationPeriods         CollaboratorVacationPeriod[] @relation("OrgVacationPeriods")
  benefits                Benefit[]                    @relation("OrgBenefits")
  collabBenefits          CollaboratorBenefit[]        @relation("OrgCollabBenefits")
  trainingCourses         TrainingCourse[]             @relation("OrgTrainingCourses")
  collabTrainings         CollaboratorTraining[]       @relation("OrgCollabTrainings")
  perfReviews             PerformanceReview[]          @relation("OrgPerfReviews")
  perfReviewInputs        PerformanceReviewInput[]     @relation("OrgReviewInputs")
  perfGoals               PerformanceGoal[]            @relation("OrgPerfGoals")
  salarios                CollaboratorSalary[]         @relation("OrgSalaries")
  feedbacks               PerformanceFeedback[]        @relation("OrgFeedbacks")
  skills                  Skill[]                      @relation("OrgSkills")
  ausencias               Ausencia[]                   @relation("OrgAusencias")
  workflowRequests        WorkflowRequest[]            @relation("OrgWorkflowRequests")
  squads                  Squad[]                      @relation("OrgSquads")
  aprovadoresSetor        AprovadorSetor[]
  billing                 OrgBilling?
  workflowTemplates       WorkflowTemplate[]           @relation("OrgWorkflowTemplates")
  chamadoTemplates        ChamadoTemplate[]            @relation("OrgChamadoTemplates")
  webhooks                Webhook[]
  monitoringKey           String?                      @map("monitoring_key")
  pingLogs                PingLog[]

  // ── Chamados v2 (campos custom) ──
  chamadoCustomFields ChamadoCustomField[]

  // ── Monitoramento Operacional (modulo independente) ──
  monAssets        MonAsset[]
  monUnidades      MonUnidade[]
  monStatusEvents  MonStatusEvent[]
  monMaps          MonMap[]
  monAlertChannels MonAlertChannel[]
  monAlertRules    MonAlertRule[]
  monSlaMetas      MonSlaMeta[]
  monServices      MonService[]
  monServiceEvents MonServiceEvent[]
  osaMonitores     OsaMonitor[]

  // ── Financeiro ──
  contasPagar ContaPagar[]

  // ── Gestão de Frotas ──
  veiculos            Veiculo[]
  motoristas          Motorista[]
  categoriasVeiculo   CategoriaVeiculo[]
  pneus               Pneu[]
  revisoesVeiculo     RevisaoVeiculo[]
  manutencoesVeiculo  ManutencaoVeiculo[]
  documentosVeiculo   DocumentoVeiculo[]
  abastecimentos      Abastecimento[]
  condutoresVeiculo   VeiculoCondutor[]
  motoristaRenovacoes MotoristaCnhRenovacao[]
  motoristaAnexos     MotoristaAnexo[]
  pneuEventos         PneuEvento[]
  pneuLayouts         PneuLayout[]
  planosRevisao       PlanoRevisao[]
  manutencaoMaoObra   ManutencaoMaoObra[]
  manutencaoAnexos    ManutencaoAnexo[]
  documentoAnexos     DocumentoAnexo[]
  reportSchedules     FrotaReportSchedule[]
  reservasVeiculo     ReservaVeiculo[]

  // ── Compliance (Gestão de Obrigações) ──
  complianceCategorias     ComplianceCategoria[]        @relation("OrgComplianceCategorias")
  complianceCampos         ComplianceCampoDefinicao[]   @relation("OrgComplianceCampos")
  complianceOrgaos         ComplianceOrgao[]            @relation("OrgComplianceOrgaos")
  complianceObrigacoes     ComplianceObrigacao[]        @relation("OrgComplianceObrigacoes")
  complianceCampoValores   ComplianceCampoValor[]       @relation("OrgComplianceCampoValores")
  complianceResponsaveis   ComplianceResponsavel[]      @relation("OrgComplianceResponsaveis")
  complianceVersoes        ComplianceVersao[]           @relation("OrgComplianceVersoes")
  complianceArquivos       ComplianceArquivo[]          @relation("OrgComplianceArquivos")
  projectAnexos            ProjectAnexo[]               @relation("OrgProjectAnexos")
  complianceHistorico      ComplianceHistorico[]        @relation("OrgComplianceHistorico")
  complianceComentarios    ComplianceComentario[]       @relation("OrgComplianceComentarios")
  complianceFavoritos      ComplianceFavorito[]         @relation("OrgComplianceFavoritos")
  complianceTags           ComplianceTag[]              @relation("OrgComplianceTags")
  complianceRegras         ComplianceAlertaRegra[]      @relation("OrgComplianceRegras")
  complianceTemplates      ComplianceTemplate[]         @relation("OrgComplianceTemplates")
  complianceEscalonamentos ComplianceEscalonamento[]    @relation("OrgComplianceEscalonamentos")
  complianceEnvios         ComplianceNotificacaoEnvio[] @relation("OrgComplianceEnvios")
  complianceFluxos         ComplianceFluxo[]            @relation("OrgComplianceFluxos")
  complianceEtapas         ComplianceFluxoEtapa[]       @relation("OrgComplianceEtapas")
  complianceAprovacoes     ComplianceAprovacao[]        @relation("OrgComplianceAprovacoes")

  @@map("organizations")
}

model OrgWhatsappConfig {
  id             String       @id @default(uuid())
  organizationId String       @unique @map("organization_id")
  instanceName   String       @unique @map("instance_name")
  phoneNumber    String?      @map("phone_number")
  conectado      Boolean      @default(false)
  ultimaConexao  DateTime?    @map("ultima_conexao")
  criadoEm       DateTime     @default(now()) @map("criado_em")
  atualizadoEm   DateTime     @updatedAt @map("atualizado_em")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("org_whatsapp_configs")
}

model SuperAdmin {
  id       String   @id @default(uuid())
  userId   String   @unique @map("user_id")
  criadoEm DateTime @default(now()) @map("criado_em")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("super_admins")
}

// ── Users ─────────────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  nome             String
  email            String
  senhaHash        String    @map("senha_hash")
  ativo            Boolean   @default(true)
  avatar           String?
  ultimoLogin      DateTime? @map("ultimo_login")
  primeiroAcesso   Boolean   @default(true) @map("primeiro_acesso")
  bloqueado        Boolean   @default(false) @map("bloqueado")
  tentativasFalhas Int       @default(0) @map("tentativas_falhas")
  // Acesso de teste (trial) criado pela landing page. `isTrial` marca a conta;
  // `trialExpiraEm` é o teto de 7 dias (login bloqueia depois); `trialModulo` é
  // o produto Orkiestri One escolhido no modal; `trialAvisadoSuporte` evita
  // reavisar o suporte todo dia depois que a conta vence.
  isTrial          Boolean   @default(false) @map("is_trial")
  trialExpiraEm    DateTime? @map("trial_expira_em")
  trialModulo      String?   @map("trial_modulo")
  trialAvisadoSuporte Boolean @default(false) @map("trial_avisado_suporte")
  // Efetivação (assinatura) marcada à mão pelo admin no painel de Indicações.
  assinaturaEm        DateTime? @map("assinatura_em")
  assinaturaValor     Int?      @map("assinatura_valor")
  criadoEm         DateTime  @default(now()) @map("criado_em")
  atualizadoEm     DateTime  @updatedAt @map("atualizado_em")

  organization               Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  superAdmin                 SuperAdmin?
  userRoles                  UserRole[]                  @relation("UserToRoles")
  rolesAtrib                 UserRole[]                  @relation("AtribuidoPor")
  sessions                   UserSession[]
  eventsOwner                Event[]                     @relation("EventOwner")
  eventsCriados              Event[]                     @relation("EventCreator")
  eventParticipants          EventParticipant[]
  calendarConnections        CalendarConnection[]
  projectsOwner              Project[]                   @relation("ProjectOwner")
  projectAnexosCriados       ProjectAnexo[]              @relation("ProjectAnexoAutor")
  projectMembers             ProjectMember[]
  tasksAssignee              Task[]                      @relation("TaskAssignee")
  tasksCriadas               Task[]                      @relation("TaskCreator")
  taskComments               TaskComment[]
  notes                      Note[]
  noteLabels                 NoteLabel[]
  noteCollabs                NoteCollaborator[]
  checklistItems             ChecklistItem[]             @relation("ChecklistAssignee")
  dailyTasks                 DailyTask[]
  notifications              Notification[]
  auditLogs                  AuditLog[]
  profile                    UserProfile?
  indicacoesFeitas           Referral[]                  @relation("IndicacoesFeitas")
  indicacaoRecebida          Referral?                   @relation("IndicacaoRecebida")
  chamadosSolicitados        Chamado[]                   @relation("ChamadoSolicitante")
  chamadosAtendidos          Chamado[]                   @relation("ChamadoAtendente")
  comentariosChamado         ChamadoComentario[]
  chamadoAuditorias          ChamadoAuditoria[]
  chamadoWatchers            ChamadoWatcher[]            @relation("ChamadoWatcher")
  chamadoSubtasks            ChamadoSubtask[]            @relation("ChamadoSubtask")
  chamadoLinksCriados        ChamadoLink[]               @relation("ChamadoLinkCreator")
  permissionOverrides        UserPermissionOverride[]
  passwordResetOtps          PasswordResetOtp[]
  clientesResponsavel        Cliente[]                   @relation("ClienteResponsavel")
  clienteTimelines           ClienteTimeline[]
  ciclosAprovados            OrcamentoCiclo[]            @relation("CicloAprovador")
  ciclosProprios             OrcamentoCiclo[]            @relation("CicloOwner")
  orcamentosCompartilhados   OrcamentoCompartilhamento[] @relation("OrcCompUser")
  centrosCustoResponsavel    CentroCusto[]               @relation("CentroCustoResp")
  itensOrcamentoCriados      ItemOrcamento[]             @relation("ItemCriador")
  lancamentosOrcamento       ItemOrcamentoMes[]          @relation("LancadoPor")
  aprovacoesSolicitadas      AprovacaoOrcamento[]        @relation("AprovSolicitante")
  aprovacoesDecididas        AprovacaoOrcamento[]        @relation("AprovDecisao")
  orcamentoTimelines         OrcamentoTimeline[]         @relation("OrcTimeline")
  suppliersCriados           Supplier[]                  @relation("SupplierCriador")
  supplierHistory            SupplierHistory[]
  supplierDocuments          SupplierDocument[]
  setoresResponsavel         Setor[]                     @relation("SetorResponsavel")
  artigosConhecimento        ArtigoConhecimento[]        @relation("ArtigoAutor")
  ativosResponsavel          Ativo[]                     @relation("AtivoResponsavel")
  monAssetsResponsavel       MonAsset[]                  @relation("MonAssetResponsavel")
  transferenciasRealizadas   TransferenciaAtivo[]        @relation("TransfPor")
  transferenciasRecebidas    TransferenciaAtivo[]        @relation("TransfPara")
  transferenciasEnviadas     TransferenciaAtivo[]        @relation("TransfDe")
  apontamentosHoras          ApontamentoHoras[]
  contratosResponsavel       Contrato[]                  @relation("ContratoResponsavel")
  faturas                    Fatura[]                    @relation("FaturaCriador")
  cadastroRequestsAprovados  CadastroRequest[]           @relation("CadReqAprovador")
  cadastroRequestsCriados    CadastroRequest[]           @relation("CadReqCriador")
  collaborator               Collaborator?               @relation("UserCollaborator")
  ausenciasSolicitadas       Ausencia[]                  @relation("AusenciaSolicitante")
  ausenciasAprovadas         Ausencia[]                  @relation("AusenciaAprovador")
  wfRequestsSolicitadas      WorkflowRequest[]           @relation("WfReqSolicitante")
  wfRequestsParaAprovar      WorkflowRequest[]           @relation("WfReqAprovadorAtual")
  wfRequestsAprovadas        WorkflowRequest[]           @relation("WfReqAprovador")
  wfRequestsRejeitadas       WorkflowRequest[]           @relation("WfReqRejeitador")
  wfApprovals                WorkflowApproval[]          @relation("WfApprovalAprovador")
  aprovadoresPrimarioDeSetor AprovadorSetor[]            @relation("AprovadorPrimario")
  aprovadoresBackupDeSetor   AprovadorSetor[]            @relation("AprovadorBackup")
  aprovadoresConfigurados    AprovadorSetor[]            @relation("AprovadorConfigurador")
  workflowTemplatesCriados   WorkflowTemplate[]          @relation("WfTemplateCriador")
  chamadoTemplatesCriados    ChamadoTemplate[]           @relation("ChamadoTemplateCriador")
  chamadoAnexosUploads       ChamadoAnexo[]              @relation("AnexoUploader")
  veiculosResponsavel        Veiculo[]                   @relation("VeiculoResponsavel")
  manutencoesSolicitadas     ManutencaoVeiculo[]         @relation("ManutencaoSolicitante")
  reservasVeiculoSolicitadas ReservaVeiculo[]            @relation("ReservaVeiculoSolicitante")
  complianceResponsavelPor   ComplianceResponsavel[]     @relation("ComplianceResponsavelUser")
  complianceHistoricoFeito   ComplianceHistorico[]       @relation("ComplianceHistoricoUser")
  complianceComentarios      ComplianceComentario[]      @relation("ComplianceComentarioUser")
  complianceFavoritos        ComplianceFavorito[]        @relation("ComplianceFavoritoUser")
  complianceEscalonamentos   ComplianceEscalonamento[]   @relation("ComplianceEscalonamentoUser")
  complianceAprovacoes       ComplianceAprovacao[]       @relation("ComplianceAprovadorUser")

  chamadosAtribuidosPorMim Chamado[] @relation("ChamadoAtribuidor")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

// ── Orçamento ──────────────────────────────────────────────────────────────────

model OrcamentoCiclo {
  id                String                      @id @default(uuid())
  organizationId    String                      @map("organization_id")
  ano               Int
  descricao         String?
  status            String                      @default("rascunho")
  // Dono do orçamento: null = corporativo (o orçamento único da organização),
  // preenchido = orçamento pessoal, visível só ao dono e a quem ele compartilhar.
  ownerId           String?                     @map("owner_id")
  owner             User?                       @relation("CicloOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  aprovadoPorId     String?                     @map("aprovado_por_id")
  aprovadoPor       User?                       @relation("CicloAprovador", fields: [aprovadoPorId], references: [id], onDelete: SetNull)
  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itens             ItemOrcamento[]
  compartilhamentos OrcamentoCompartilhamento[]
  criadoEm          DateTime                    @default(now()) @map("criado_em")
  atualizadoEm      DateTime                    @updatedAt @map("atualizado_em")

  // Um orçamento por dono por ano (corporativo = owner null; pessoais por owner).
  @@unique([organizationId, ownerId, ano])
  @@index([organizationId])
  @@map("orcamento_ciclos")
}

// Quem tem acesso a um orçamento pessoal. Presença na tabela = ver e editar.
model OrcamentoCompartilhamento {
  id            String         @id @default(uuid())
  cicloId       String         @map("ciclo_id")
  ciclo         OrcamentoCiclo @relation(fields: [cicloId], references: [id], onDelete: Cascade)
  userId        String         @map("user_id")
  user          User           @relation("OrcCompUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Compartilhar UM centro de custo do ciclo, e não o ciclo inteiro.
  centroCustoId String?        @map("centro_custo_id")
  centroCusto   CentroCusto?   @relation(fields: [centroCustoId], references: [id], onDelete: Cascade)
  /// editor | leitor
  papel         String         @default("editor")
  criadoPorId   String?        @map("criado_por_id")
  criadoEm      DateTime       @default(now()) @map("criado_em")

  @@unique([cicloId, userId, centroCustoId])
  @@map("orcamento_compartilhamentos")
}

// Regras de alerta por organização: o admin escolhe se um tipo de alerta está
// ativo, por quais canais chega e para quem. Uma regra por (organização, tipo).
model AlertaRegra {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  tipo           String // orcamento_estouro | sla_risco | garantia_vencendo | documento_vencendo
  ativo          Boolean      @default(true)
  canais         String       @default("[\"sistema\"]") // JSON: ["sistema","email","whatsapp"]
  destinatarios  String       @default("[]") // JSON: user ids e/ou e-mails
  atualizadoEm   DateTime     @updatedAt @map("atualizado_em")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, tipo])
  @@map("alerta_regras")
}

model CentroCusto {
  id                String                      @id @default(uuid())
  organizationId    String                      @map("organization_id")
  codigo            String
  nome              String
  descricao         String?
  cor               String                      @default("#a78bfa")
  ativo             Boolean                     @default(true)
  responsavelId     String?                     @map("responsavel_id")
  responsavel       User?                       @relation("CentroCustoResp", fields: [responsavelId], references: [id], onDelete: SetNull)
  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itens             ItemOrcamento[]
  compartilhamentos OrcamentoCompartilhamento[]
  criadoEm          DateTime                    @default(now()) @map("criado_em")

  @@unique([organizationId, codigo])
  @@map("centros_custo")
}

model CategoriaOrcamento {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  tipo           String
  codigo         String
  nome           String
  cor            String               @default("#a78bfa")
  icone          String?
  paiId          String?              @map("pai_id")
  pai            CategoriaOrcamento?  @relation("CatPai", fields: [paiId], references: [id])
  filhas         CategoriaOrcamento[] @relation("CatPai")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itens          ItemOrcamento[]
  criadoEm       DateTime             @default(now()) @map("criado_em")

  @@index([organizationId])
  @@map("categorias_orcamento")
}

model FornecedorOrcamento {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  nome           String
  cnpj           String?
  email          String?
  telefone       String?
  segmento       String?
  ativo          Boolean         @default(true)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itens          ItemOrcamento[]
  criadoEm       DateTime        @default(now()) @map("criado_em")

  @@index([organizationId])
  @@map("fornecedores_orcamento")
}

model ItemOrcamento {
  id            String               @id @default(uuid())
  cicloId       String               @map("ciclo_id")
  ciclo         OrcamentoCiclo       @relation(fields: [cicloId], references: [id])
  centroCustoId String?              @map("centro_custo_id")
  centroCusto   CentroCusto?         @relation(fields: [centroCustoId], references: [id])
  categoriaId   String               @map("categoria_id")
  categoria     CategoriaOrcamento   @relation(fields: [categoriaId], references: [id])
  tipo          String
  nome          String
  descricao     String?
  fornecedorId  String?              @map("fornecedor_id")
  fornecedor    FornecedorOrcamento? @relation(fields: [fornecedorId], references: [id])
  supplierId    String?              @map("supplier_id")
  supplier      Supplier?            @relation("ItemSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  recorrente    Boolean              @default(false)
  periodicidade String               @default("mensal")
  status        String               @default("ativo")
  observacoes   String?
  meses         ItemOrcamentoMes[]
  timeline      OrcamentoTimeline[]
  aprovacoes    AprovacaoOrcamento[]
  criadoPorId   String               @map("criado_por_id")
  criadoPor     User                 @relation("ItemCriador", fields: [criadoPorId], references: [id])
  criadoEm      DateTime             @default(now()) @map("criado_em")
  atualizadoEm  DateTime             @updatedAt @map("atualizado_em")

  @@map("itens_orcamento")
}

model ItemOrcamentoMes {
  id             String        @id @default(uuid())
  itemId         String        @map("item_id")
  item           ItemOrcamento @relation(fields: [itemId], references: [id], onDelete: Cascade)
  mes            Int
  valorPrevisto  Float         @default(0) @map("valor_previsto")
  valorRealizado Float?        @map("valor_realizado")
  status         String        @default("pendente")
  observacoes    String?
  lancadoPorId   String?       @map("lancado_por_id")
  lancadoPor     User?         @relation("LancadoPor", fields: [lancadoPorId], references: [id], onDelete: SetNull)
  lancadoEm      DateTime?     @map("lancado_em")

  @@unique([itemId, mes])
  @@map("itens_orcamento_mes")
}

model AprovacaoOrcamento {
  id              String         @id @default(uuid())
  itemId          String?        @map("item_id")
  item            ItemOrcamento? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tipo            String
  status          String         @default("pendente")
  solicitadoPorId String         @map("solicitado_por_id")
  solicitadoPor   User           @relation("AprovSolicitante", fields: [solicitadoPorId], references: [id])
  aprovadoPorId   String?        @map("aprovado_por_id")
  aprovadoPor     User?          @relation("AprovDecisao", fields: [aprovadoPorId], references: [id], onDelete: SetNull)
  observacoes     String?
  criadoEm        DateTime       @default(now()) @map("criado_em")
  resolvidoEm     DateTime?      @map("resolvido_em")

  @@map("aprovacoes_orcamento")
}

model OrcamentoTimeline {
  id        String        @id @default(uuid())
  itemId    String        @map("item_id")
  item      ItemOrcamento @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tipo      String
  titulo    String
  descricao String?
  userId    String?       @map("user_id")
  user      User?         @relation("OrcTimeline", fields: [userId], references: [id], onDelete: SetNull)
  criadoEm  DateTime      @default(now()) @map("criado_em")

  @@map("orcamento_timeline")
}

// ── Auth / Access ──────────────────────────────────────────────────────────────

model UserRequest {
  id              String    @id @default(uuid())
  organizationId  String?   @map("organization_id")
  nome            String
  email           String
  whatsapp        String?
  cargo           String?
  departamento    String?
  empresa         String?
  motivacao       String?
  // Produtos do Orkiestri One que o solicitante quer testar (vindo da landing
  // page). Vazio quando a solicitação nasce de dentro do sistema, onde não há
  // essa escolha. Array nativo do Postgres — default '{}' para não quebrar as
  // linhas já existentes na migração.
  produtos        String[]  @default([])
  status          String    @default("PENDENTE")
  approvedById    String?   @map("approved_by_id")
  approvedAt      DateTime? @map("approved_at")
  rejectionReason String?   @map("rejection_reason")
  // ── Workforce (preenchidos na aprovação) ─────────────────
  setorId         String?   @map("setor_id")
  gestorId        String?   @map("gestor_id")
  jornadaHorasDia Float?    @map("jornada_horas_dia")
  squad           String?
  perfilRoleId    String?   @map("perfil_role_id")
  senioridade     String?
  tipoVinculo     String?   @map("tipo_vinculo")
  criadoEm        DateTime  @default(now()) @map("criado_em")
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em")

  @@map("user_requests")
}

// ── Workforce: Squads ──────────────────────────────────────────────────────
model Squad {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  nome           String
  descricao      String?
  cor            String?
  liderId        String?  @map("lider_id")
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  organization Organization  @relation("OrgSquads", fields: [organizationId], references: [id], onDelete: Cascade)
  lider        Collaborator? @relation("SquadLider", fields: [liderId], references: [id], onDelete: SetNull)
  members      SquadMember[]

  @@unique([organizationId, nome])
  @@index([organizationId])
  @@map("squads")
}

model SquadMember {
  id              String   @id @default(uuid())
  squadId         String   @map("squad_id")
  collaboratorId  String   @map("collaborator_id")
  alocacaoPercent Int      @default(100) @map("alocacao_percent")
  papel           String   @default("membro")
  criadoEm        DateTime @default(now()) @map("criado_em")

  squad        Squad        @relation(fields: [squadId], references: [id], onDelete: Cascade)
  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)

  @@unique([squadId, collaboratorId])
  @@index([squadId])
  @@index([collaboratorId])
  @@map("squad_members")
}

// ── Workforce: Workflows de Aprovação ──────────────────────────────────────
model WorkflowRequest {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  solicitanteId    String    @map("solicitante_id")
  tipo             String // despesa | horas_extra | alteracao_cadastral | folga_compensatoria | outro
  titulo           String
  descricao        String?   @db.Text
  payload          Json?
  valor            Float?
  status           String    @default("PENDENTE") // PENDENTE | APROVADA | REJEITADA | CANCELADA
  aprovadorAtualId String?   @map("aprovador_atual_id")
  aprovadoPorId    String?   @map("aprovado_por_id")
  aprovadoEm       DateTime? @map("aprovado_em")
  rejeitadoPorId   String?   @map("rejeitado_por_id")
  rejeitadoEm      DateTime? @map("rejeitado_em")
  motivoRejeicao   String?   @map("motivo_rejeicao")
  ultimoLembreteEm DateTime? @map("ultimo_lembrete_em")
  escaladoEm       DateTime? @map("escalado_em")
  criadoEm         DateTime  @default(now()) @map("criado_em")
  atualizadoEm     DateTime  @updatedAt @map("atualizado_em")

  organization   Organization       @relation("OrgWorkflowRequests", fields: [organizationId], references: [id], onDelete: Cascade)
  solicitante    User               @relation("WfReqSolicitante", fields: [solicitanteId], references: [id], onDelete: Cascade)
  aprovadorAtual User?              @relation("WfReqAprovadorAtual", fields: [aprovadorAtualId], references: [id], onDelete: SetNull)
  aprovadoPor    User?              @relation("WfReqAprovador", fields: [aprovadoPorId], references: [id], onDelete: SetNull)
  rejeitadoPor   User?              @relation("WfReqRejeitador", fields: [rejeitadoPorId], references: [id], onDelete: SetNull)
  aprovacoes     WorkflowApproval[]

  @@index([organizationId])
  @@index([solicitanteId])
  @@index([aprovadorAtualId])
  @@index([status])
  @@index([tipo])
  @@map("workflow_requests")
}

model WorkflowApproval {
  id          String   @id @default(uuid())
  requestId   String   @map("request_id")
  aprovadorId String   @map("aprovador_id")
  nivel       Int      @default(1)
  decisao     String // APROVADO | REJEITADO | ESCALADO
  observacoes String?
  criadoEm    DateTime @default(now()) @map("criado_em")

  request   WorkflowRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  aprovador User            @relation("WfApprovalAprovador", fields: [aprovadorId], references: [id])

  @@index([requestId])
  @@index([aprovadorId])
  @@map("workflow_approvals")
}

// ── Workflow Templates (Fase 3 — Workflow Visual) ──────────────────────────────
model WorkflowTemplate {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  nome           String
  descricao      String?
  tipo           String   @default("outro") // ti | rh | financeiro | juridico | compras | facilities | outro
  icone          String?
  cor            String   @default("#a78bfa")
  ativo          Boolean  @default(true)
  etapas         Json     @default("[]")
  criadoPorId    String   @map("criado_por_id")
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  organization Organization @relation("OrgWorkflowTemplates", fields: [organizationId], references: [id], onDelete: Cascade)
  criadoPor    User         @relation("WfTemplateCriador", fields: [criadoPorId], references: [id])

  @@index([organizationId])
  @@map("workflow_templates")
}

// Matriz de aprovadores por setor — 1 primário + 1 backup com vigência.
// Quando a vigência do backup está ativa (hoje entre inicio e fim), todas as
// solicitações novas (e os lembretes que escalam) vão para o backup. Fora da
// vigência, voltam ao primário automaticamente.
model AprovadorSetor {
  id                String    @id @default(uuid())
  organizationId    String    @map("organization_id")
  setorId           String    @unique @map("setor_id")
  aprovadorId       String    @map("aprovador_id")
  backupAprovadorId String?   @map("backup_aprovador_id")
  backupInicio      DateTime? @map("backup_inicio")
  backupFim         DateTime? @map("backup_fim")
  configuradoPorId  String?   @map("configurado_por_id")
  criadoEm          DateTime  @default(now()) @map("criado_em")
  atualizadoEm      DateTime  @updatedAt @map("atualizado_em")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  setor           Setor        @relation(fields: [setorId], references: [id], onDelete: Cascade)
  aprovador       User         @relation("AprovadorPrimario", fields: [aprovadorId], references: [id], onDelete: Cascade)
  backupAprovador User?        @relation("AprovadorBackup", fields: [backupAprovadorId], references: [id], onDelete: SetNull)
  configuradoPor  User?        @relation("AprovadorConfigurador", fields: [configuradoPorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([aprovadorId])
  @@index([backupAprovadorId])
  @@map("aprovadores_setor")
}

// ── Workforce: Ausências ───────────────────────────────────────────────────
model Ausencia {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  collaboratorId   String    @map("collaborator_id")
  tipo             String // ferias | atestado | folga | licenca | banco_horas | outro
  dataInicio       DateTime  @map("data_inicio")
  dataFim          DateTime  @map("data_fim")
  diaInteiro       Boolean   @default(true) @map("dia_inteiro")
  horasDia         Float?    @map("horas_dia") // se dia_inteiro=false, horas que serão deduzidas por dia
  descricao        String?
  documentoUrl     String?   @map("documento_url")
  status           String    @default("PENDENTE") // PENDENTE | APROVADA | REJEITADA | CANCELADA
  // Só para tipo=ferias: a qual período aquisitivo estes dias são debitados.
  // Atribuição explícita em vez de inferida por data — férias podem cruzar a
  // virada de período, e adivinhar produziria saldo errado.
  vacationPeriodId String?   @map("vacation_period_id")
  solicitadaPorId  String?   @map("solicitada_por_id")
  aprovadaPorId    String?   @map("aprovada_por_id")
  aprovadaEm       DateTime? @map("aprovada_em")
  motivoRejeicao   String?   @map("motivo_rejeicao")
  criadoEm         DateTime  @default(now()) @map("criado_em")
  atualizadoEm     DateTime  @updatedAt @map("atualizado_em")

  organization   Organization                @relation("OrgAusencias", fields: [organizationId], references: [id], onDelete: Cascade)
  collaborator   Collaborator                @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  vacationPeriod CollaboratorVacationPeriod? @relation(fields: [vacationPeriodId], references: [id], onDelete: SetNull)
  solicitadaPor  User?                       @relation("AusenciaSolicitante", fields: [solicitadaPorId], references: [id], onDelete: SetNull)
  aprovadaPor    User?                       @relation("AusenciaAprovador", fields: [aprovadaPorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([collaboratorId])
  @@index([dataInicio])
  @@index([status])
  @@map("ausencias")
}

// ── Workforce: Skills ──────────────────────────────────────────────────────
model Skill {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  nome           String
  categoria      String?
  descricao      String?
  cor            String?
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  organization  Organization            @relation("OrgSkills", fields: [organizationId], references: [id], onDelete: Cascade)
  collaborators CollaboratorSkill[]
  chamados      Chamado[]               @relation("ChamadoSkill")
  requisitos    CareerStepRequirement[]

  @@unique([organizationId, nome])
  @@index([organizationId])
  @@index([categoria])
  @@map("skills")
}

model CollaboratorSkill {
  id             String    @id @default(uuid())
  collaboratorId String    @map("collaborator_id")
  skillId        String    @map("skill_id")
  nivel          String    @default("pleno") // junior | pleno | senior | especialista
  certificadoEm  DateTime? @map("certificado_em")
  validade       DateTime?
  observacoes    String?
  criadoEm       DateTime  @default(now()) @map("criado_em")

  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  skill        Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([collaboratorId, skillId])
  @@index([collaboratorId])
  @@index([skillId])
  @@map("collaborator_skills")
}

// ── Workforce / Colaboradores ──────────────────────────────────────────────
model Collaborator {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  // Opcional: nem todo colaborador tem acesso ao sistema. Continua único —
  // um usuário está vinculado a no máximo um colaborador. Ver docs/people/ADR-001.
  userId           String?   @unique @map("user_id")
  matricula        String?
  fotoUrl          String?   @map("foto_url")
  emailCorporativo String?   @map("email_corporativo")
  telefone         String?
  // ── Identidade própria (People) ────────────────────────────────────────
  // O colaborador precisa existir sem depender de um User: nem todo funcionário
  // tem login. Backfill inicial: nomeCompleto = user.nome. Ver docs/people/ADR-001.
  nomeCompleto     String?   @map("nome_completo")
  emailPessoal     String?   @map("email_pessoal")
  celular          String?
  dataNascimento   DateTime? @map("data_nascimento")
  genero           String?
  estadoCivil      String?   @map("estado_civil")
  nacionalidade    String?
  dataAdmissao     DateTime? @map("data_admissao")
  dataDesligamento DateTime? @map("data_desligamento")
  // Situação funcional. Fonte de verdade a partir do People Hub.
  // ATIVO | INATIVO | AFASTADO | DESLIGADO | SUSPENSO
  // `ativo` (abaixo) é mantido em sincronia para os consumidores legados.
  status           String    @default("ATIVO")
  // Estrutura organizacional
  cargo            String?
  positionId       String?   @map("position_id")
  departamento     String?
  setorId          String?   @map("setor_id")
  squad            String?
  especialidade    String?
  senioridade      String?
  gestorId         String?   @map("gestor_id")
  /// Trilha de carreira. Nulo = não definida, e aí a trilha é inferida pelo
  /// cargo atual quando ele aparece em exatamente uma.
  careerTrackId    String?   @map("career_track_id")
  // Operacionais
  jornadaHorasDia  Float?    @map("jornada_horas_dia")
  jornadaHorasMes  Float?    @map("jornada_horas_mes")
  turno            String?
  escala           String?
  tipoVinculo      String?   @map("tipo_vinculo")
  // Legado: redundante com CollaboratorSkill. Não usado pelo People Hub;
  // removido na Fase 6, quando Treinamentos absorver as certificações.
  skills           Json?
  certificacoes    Json?
  // Derivado de `status`, mantido para os consumidores legados (Capacity, Squads).
  ativo            Boolean   @default(true)
  criadoEm         DateTime  @default(now()) @map("criado_em")
  criadoPorId      String?   @map("criado_por_id")
  atualizadoEm     DateTime  @updatedAt @map("atualizado_em")
  atualizadoPorId  String?   @map("atualizado_por_id")
  excluidoEm       DateTime? @map("excluido_em")
  /// Quando o dado pessoal foi eliminado (LGPD art. 16). Distinto de
  /// `excluidoEm`: soft delete some da tela e volta atrás; anonimização apaga
  /// o que identifica a pessoa e é irreversível. Ver domain/privacidade.entity.
  anonimizadoEm    DateTime? @map("anonimizado_em")

  organization             Organization                 @relation("OrgCollaborators", fields: [organizationId], references: [id], onDelete: Cascade)
  // SetNull, não Cascade: excluir o login de alguém não pode apagar o registro
  // funcional da pessoa, que tem retenção legal.
  user                     User?                        @relation("UserCollaborator", fields: [userId], references: [id], onDelete: SetNull)
  setor                    Setor?                       @relation("SetorCollaborators", fields: [setorId], references: [id], onDelete: SetNull)
  position                 Position?                    @relation("PositionCollaborators", fields: [positionId], references: [id], onDelete: SetNull)
  gestor                   Collaborator?                @relation("CollabHierarchy", fields: [gestorId], references: [id], onDelete: SetNull)
  liderados                Collaborator[]               @relation("CollabHierarchy")
  collabSkills             CollaboratorSkill[]
  ausencias                Ausencia[]
  squadsLiderados          Squad[]                      @relation("SquadLider")
  squadMemberships         SquadMember[]
  periodosFerias           CollaboratorVacationPeriod[]
  enderecos                CollaboratorAddress[]
  contatos                 CollaboratorContact[]
  historico                CollaboratorHistory[]
  documentos               CollaboratorDocument[]
  beneficios               CollaboratorBenefit[]
  treinamentos             CollaboratorTraining[]
  avaliacoes               PerformanceReview[]          @relation("ReviewAvaliado")
  avaliacoesFeitas         PerformanceReview[]          @relation("ReviewAvaliador")
  entradas360              PerformanceReviewInput[]     @relation("ReviewInputAvaliador")
  salarios                 CollaboratorSalary[]
  feedbacks                PerformanceFeedback[]        @relation("FeedbackSobre")
  feedbacksDados           PerformanceFeedback[]        @relation("FeedbackAutor")
  careerTrack              CareerTrack?                 @relation("TrackCollaborators", fields: [careerTrackId], references: [id], onDelete: SetNull)
  checklists               CollaboratorChecklist[]
  complianceResponsavelPor ComplianceResponsavel[]

  @@unique([organizationId, matricula])
  @@index([careerTrackId])
  @@index([organizationId])
  @@index([setorId])
  @@index([gestorId])
  @@index([positionId])
  @@index([status])
  @@index([excluidoEm])
  @@map("collaborators")
}

// ── People: Cargos ─────────────────────────────────────────────────────────
// Hoje `cargo` é string livre em 6 tabelas. Sem entidade não há análise de
// cargos nem distribuição organizacional. Ver docs/people/MIGRATION_MATRIX.md.
model Position {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  titulo          String
  codigo          String?
  descricao       String?
  nivel           String?
  ativo           Boolean   @default(true)
  /// Faixa salarial do cargo. Sem histórico próprio: quando muda, vale para
  /// todo mundo dali em diante.
  salarioMinimo   Decimal?  @map("salario_minimo") @db.Decimal(12, 2)
  salarioMedio    Decimal?  @map("salario_medio") @db.Decimal(12, 2)
  salarioMaximo   Decimal?  @map("salario_maximo") @db.Decimal(12, 2)
  criadoEm        DateTime  @default(now()) @map("criado_em")
  criadoPorId     String?   @map("criado_por_id")
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em")
  atualizadoPorId String?   @map("atualizado_por_id")
  excluidoEm      DateTime? @map("excluido_em")

  organization    Organization         @relation("OrgPositions", fields: [organizationId], references: [id], onDelete: Cascade)
  collaborators   Collaborator[]       @relation("PositionCollaborators")
  salarios        CollaboratorSalary[]
  degrausCarreira CareerTrackStep[]

  @@unique([organizationId, titulo])
  @@index([organizationId])
  @@map("positions")
}

// ── People: Checklist de admissão e desligamento ───────────────────────────
// A instância COPIA os itens do modelo em vez de apontar para ele: mudar o
// modelo depois não pode reescrever o checklist de quem já foi admitido, senão
// o histórico mente sobre o que foi exigido na época.
model ChecklistTemplate {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  nome            String
  /// admissao | desligamento
  evento          String
  descricao       String?
  ativo           Boolean  @default(true)
  criadoEm        DateTime @default(now()) @map("criado_em")
  criadoPorId     String?  @map("criado_por_id")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")
  atualizadoPorId String?  @map("atualizado_por_id")

  organization Organization            @relation("OrgChecklistTemplates", fields: [organizationId], references: [id], onDelete: Cascade)
  itens        ChecklistTemplateItem[]
  instancias   CollaboratorChecklist[]

  @@unique([organizationId, nome])
  @@index([organizationId, evento])
  @@map("checklist_templates")
}

model ChecklistTemplateItem {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  templateId     String   @map("template_id")
  ordem          Int
  titulo         String
  descricao      String?
  /// rh | gestor | colaborador
  responsavel    String   @default("rh")
  obrigatorio    Boolean  @default(true)
  /// Prazo em dias a contar do evento. Nulo = sem prazo (≠ zero, "no mesmo dia").
  prazoDias      Int?     @map("prazo_dias")
  criadoEm       DateTime @default(now()) @map("criado_em")

  organization Organization      @relation("OrgChecklistTemplateItems", fields: [organizationId], references: [id], onDelete: Cascade)
  template     ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, ordem])
  @@index([organizationId])
  @@map("checklist_template_items")
}

model CollaboratorChecklist {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  collaboratorId String    @map("collaborator_id")
  evento         String
  templateId     String?   @map("template_id")
  nome           String
  iniciadoEm     DateTime  @default(now()) @map("iniciado_em")
  concluidoEm    DateTime? @map("concluido_em")
  criadoPorId    String?   @map("criado_por_id")

  organization Organization                @relation("OrgCollaboratorChecklists", fields: [organizationId], references: [id], onDelete: Cascade)
  collaborator Collaborator                @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  template     ChecklistTemplate?          @relation(fields: [templateId], references: [id], onDelete: SetNull)
  itens        CollaboratorChecklistItem[]

  @@unique([collaboratorId, evento])
  @@index([organizationId])
  @@map("collaborator_checklists")
}

model CollaboratorChecklistItem {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  checklistId    String    @map("checklist_id")
  ordem          Int
  titulo         String
  descricao      String?
  responsavel    String    @default("rh")
  obrigatorio    Boolean   @default(true)
  prazoDias      Int?      @map("prazo_dias")
  concluidoEm    DateTime? @map("concluido_em")
  concluidoPorId String?   @map("concluido_por_id")
  observacoes    String?

  organization Organization          @relation("OrgCollaboratorChecklistItems", fields: [organizationId], references: [id], onDelete: Cascade)
  checklist    CollaboratorChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId, ordem])
  @@index([organizationId])
  @@map("collaborator_checklist_items")
}

// ── People: Plano de carreira ──────────────────────────────────────────────
// A trilha ORDENA CARGOS. Não há "nível dentro do cargo": o catálogo já carrega
// o nível e a faixa salarial está amarrada ao cargo, então um segundo eixo
// criaria duas respostas para "que nível essa pessoa é?" e a faixa não saberia
// a qual obedecer. Progredir = ocupar o próximo cargo da trilha, o que move
// faixa, organograma e histórico funcional pelo mesmo campo de sempre.
model CareerTrack {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  nome            String
  descricao       String?
  ativo           Boolean  @default(true)
  criadoEm        DateTime @default(now()) @map("criado_em")
  criadoPorId     String?  @map("criado_por_id")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")
  atualizadoPorId String?  @map("atualizado_por_id")

  organization  Organization      @relation("OrgCareerTracks", fields: [organizationId], references: [id], onDelete: Cascade)
  degraus       CareerTrackStep[]
  collaborators Collaborator[]    @relation("TrackCollaborators")

  @@unique([organizationId, nome])
  @@index([organizationId])
  @@map("career_tracks")
}

model CareerTrackStep {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  trackId        String   @map("track_id")
  positionId     String   @map("position_id")
  ordem          Int
  /// Tempo mínimo NO DEGRAU. Nulo = a trilha não usa tempo como critério, o que
  /// é diferente de zero ("nenhum tempo exigido").
  mesesMinimos   Int?     @map("meses_minimos")
  /// Nota mínima na última avaliação finalizada.
  notaMinima     Decimal? @map("nota_minima") @db.Decimal(3, 2)
  observacoes    String?
  criadoEm       DateTime @default(now()) @map("criado_em")
  criadoPorId    String?  @map("criado_por_id")

  organization Organization            @relation("OrgCareerSteps", fields: [organizationId], references: [id], onDelete: Cascade)
  track        CareerTrack             @relation(fields: [trackId], references: [id], onDelete: Cascade)
  // Restrict: apagar um cargo que é degrau abriria buraco no meio da progressão
  // e o "próximo degrau" de quem está abaixo passaria a apontar para o errado.
  position     Position                @relation(fields: [positionId], references: [id], onDelete: Restrict)
  requisitos   CareerStepRequirement[]

  @@unique([trackId, ordem])
  @@unique([trackId, positionId])
  @@index([organizationId])
  @@index([positionId])
  @@map("career_track_steps")
}

model CareerStepRequirement {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  stepId         String   @map("step_id")
  /// competencia | treinamento | manual
  tipo           String   @default("manual")
  skillId        String?  @map("skill_id")
  /// junior | pleno | senior | especialista
  nivelMinimo    String?  @map("nivel_minimo")
  trainingId     String?  @map("training_id")
  descricao      String?
  /// Não obrigatório = diferencial: conta a favor sem travar a progressão.
  obrigatorio    Boolean  @default(true)
  criadoEm       DateTime @default(now()) @map("criado_em")
  criadoPorId    String?  @map("criado_por_id")

  organization Organization    @relation("OrgCareerRequirements", fields: [organizationId], references: [id], onDelete: Cascade)
  step         CareerTrackStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  skill        Skill?          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  training     TrainingCourse? @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@index([organizationId])
  @@map("career_step_requirements")
}

// ── People: Endereços do colaborador ───────────────────────────────────────
model CollaboratorAddress {
  id             String   @id @default(uuid())
  collaboratorId String   @map("collaborator_id")
  tipo           String   @default("residencial")
  cep            String?
  logradouro     String?
  numero         String?
  complemento    String?
  bairro         String?
  cidade         String?
  estado         String?
  pais           String   @default("BR")
  principal      Boolean  @default(false)
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)

  @@index([collaboratorId])
  @@map("collaborator_addresses")
}

// ── People: Contatos do colaborador (emergência e adicionais) ──────────────
model CollaboratorContact {
  id             String   @id @default(uuid())
  collaboratorId String   @map("collaborator_id")
  nome           String
  parentesco     String?
  telefone       String?
  email          String?
  emergencia     Boolean  @default(false)
  observacoes    String?
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)

  @@index([collaboratorId])
  @@index([collaboratorId, emergencia])
  @@map("collaborator_contacts")
}

// ── People: Documentos do colaborador ──────────────────────────────────────
// Dado RESTRITO (PEOPLE_PERMISSIONS.md §21): atestado médico, documento
// pessoal, contrato. Por isso o arquivo NÃO vai para UPLOAD_DIR, que é servido
// estaticamente sem autenticação — vai para um diretório próprio, acessível só
// pelo endpoint de download que valida escopo e permissão.
model CollaboratorDocument {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  collaboratorId  String    @map("collaborator_id")
  // identidade | contrato | certificado | medico | formacao | outro
  categoria       String
  titulo          String
  descricao       String?
  // Caminho relativo à raiz segura. Nunca uma URL: o acesso é sempre mediado.
  arquivoRef      String    @map("arquivo_ref")
  nomeArquivo     String    @map("nome_arquivo")
  mimeType        String?   @map("mime_type")
  tamanhoBytes    Int?      @map("tamanho_bytes")
  dataEmissao     DateTime? @map("data_emissao")
  dataValidade    DateTime? @map("data_validade")
  // PENDENTE | APROVADO | REJEITADO | ARQUIVADO
  aprovacao       String    @default("PENDENTE")
  aprovadoPorId   String?   @map("aprovado_por_id")
  aprovadoEm      DateTime? @map("aprovado_em")
  motivoRejeicao  String?   @map("motivo_rejeicao")
  enviadoPorId    String?   @map("enviado_por_id")
  criadoEm        DateTime  @default(now()) @map("criado_em")
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em")
  atualizadoPorId String?   @map("atualizado_por_id")
  excluidoEm      DateTime? @map("excluido_em")

  organization Organization @relation("OrgCollaboratorDocuments", fields: [organizationId], references: [id], onDelete: Cascade)
  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)

  @@index([collaboratorId, excluidoEm])
  @@index([organizationId, dataValidade])
  @@index([aprovacao])
  @@map("collaborator_documents")
}

// ── People: Períodos aquisitivos de férias ─────────────────────────────────
// Persistido, e não derivado a cada consulta, por dois motivos: `diasDireito`
// admite ajuste manual (faltas reduzem o direito, abono pecuniário vende dias)
// e `diasGozados` precisa ser agregável em relatório de passivo.
// As datas em si são determinísticas a partir da admissão — ver
// domain/vacation.entity.ts, que é quem sabe a regra.
model CollaboratorVacationPeriod {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  collaboratorId   String   @map("collaborator_id")
  inicio           DateTime
  fim              DateTime
  // Prazo final para gozar. Passar daqui com saldo gera pagamento em dobro.
  limiteConcessivo DateTime @map("limite_concessivo")
  diasDireito      Int      @default(30) @map("dias_direito")
  diasGozados      Int      @default(0) @map("dias_gozados")
  // EM_AQUISICAO | ADQUIRIDO | GOZADO | VENCIDO — derivado, materializado para
  // permitir filtro e índice sem recalcular a regra em SQL.
  status           String   @default("EM_AQUISICAO")
  observacoes      String?
  criadoEm         DateTime @default(now()) @map("criado_em")
  atualizadoEm     DateTime @updatedAt @map("atualizado_em")

  organization Organization @relation("OrgVacationPeriods", fields: [organizationId], references: [id], onDelete: Cascade)
  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  ausencias    Ausencia[]

  // Um período por colaborador por data de início — a regeneração é idempotente.
  @@unique([collaboratorId, inicio])
  @@index([organizationId, status])
  @@index([organizationId, limiteConcessivo])
  @@map("collaborator_vacation_periods")
}

// ── People: Linha do tempo funcional ───────────────────────────────────────
// Conteúdo de produto (aba "Histórico" do perfil 360), lido pelo RH.
// Não confundir com AuditLog, que é trilha técnica. Ver docs/people/ADR-004.
// Absorve também o papel de `employee_assignments` da especificação.
model CollaboratorHistory {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  collaboratorId  String    @map("collaborator_id")
  // admissao | mudanca_setor | mudanca_cargo | mudanca_gestor |
  // mudanca_status | promocao | desligamento | outro
  evento          String
  campo           String?
  valorAnterior   String?   @map("valor_anterior")
  valorNovo       String?   @map("valor_novo")
  descricao       String?
  vigenciaEm      DateTime? @map("vigencia_em")
  registradoPorId String?   @map("registrado_por_id")
  registradoEm    DateTime  @default(now()) @map("registrado_em")

  organization Organization @relation("OrgCollaboratorHistory", fields: [organizationId], references: [id], onDelete: Cascade)
  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)

  @@index([collaboratorId, registradoEm(sort: Desc)])
  @@index([organizationId])
  @@index([evento])
  @@map("collaborator_history")
}

model PasswordResetOtp {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  otpCode      String   @map("otp_code")
  otpExpiresAt DateTime @map("otp_expires_at")
  otpAttempts  Int      @default(0) @map("otp_attempts")
  used         Boolean  @default(false)
  criadoEm     DateTime @default(now()) @map("criado_em")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_otps")
}

// ── Auto-signup (landing page → MP → provisionamento) ─────────────────────────
model BillingSignupSession {
  id    String @id @default(uuid())
  // Token enviado no back_url do MP; usado para polling de status
  token String @unique @default(uuid())

  plano          String
  payerEmail     String @map("payer_email")
  orgNome        String @map("org_nome")
  orgSlug        String @map("org_slug")
  adminNome      String @map("admin_nome")
  adminSenhaHash String @map("admin_senha_hash")

  mpPreapprovalId String? @map("mp_preapproval_id")
  mpCheckoutUrl   String? @map("mp_checkout_url")

  // pending | redirected | paid | completed | failed | expired
  status String @default("pending")

  organizationId String?  @map("organization_id")
  criadoEm       DateTime @default(now()) @map("criado_em")
  expiresAt      DateTime @map("expires_at")

  @@index([token])
  @@index([mpPreapprovalId])
  @@map("billing_signup_sessions")
}

model UserProfile {
  id                   String    @id @default(uuid())
  userId               String    @unique @map("user_id")
  whatsapp             String?
  whatsappAlertas      Boolean   @default(false) @map("whatsapp_alertas")
  /// LID do WhatsApp vinculado (o WhatsApp esconde o telefone de quem envia e
  /// manda só este identificador). Preenchido pela vinculação por código.
  whatsappLid          String?   @unique @map("whatsapp_lid")
  criadoEm             DateTime  @default(now()) @map("criado_em")
  twoFactorSecret      String?   @map("two_factor_secret")
  twoFactorAtivo       Boolean   @default(false) @map("two_factor_ativo")
  twoFactorBackup      String?   @map("two_factor_backup")
  statusOnline         String?   @default("disponivel") @map("status_online")
  setorId              String?   @map("setor_id")
  cargo                String?
  telefone             String?
  /// Verificação do WhatsApp por código. Migration notificacoes_por_modulo.
  whatsappVerificado   Boolean   @default(false) @map("whatsapp_verificado")
  whatsappCodigo       String?   @map("whatsapp_codigo")
  whatsappCodigoExpira DateTime? @map("whatsapp_codigo_expira")
  whatsappTentativas   Int       @default(0) @map("whatsapp_tentativas")
  /// Desliga o resumo semanal de Gastos no WhatsApp (comando "parar resumo").
  resumoGastosOff      Boolean   @default(false) @map("resumo_gastos_off")
  modulos              String    @default("[\"projetos\",\"keep\",\"gantt\",\"relatorios\"]")
  setor                Setor?    @relation(fields: [setorId], references: [id])
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// Indicações (referral) — MVP MANUAL, sem gateway de pagamento.
// O código do indicador é DERIVADO do userId (não há tabela de códigos); esta
// tabela é a fonte da verdade do vínculo + efetivação + comissão. Valores em
// centavos, gravados na própria linha para preservar histórico.
model Referral {
  id              String    @id @default(uuid())
  codigoUsado     String    @map("codigo_usado")            // código digitado no cadastro
  indicadorUserId String    @map("indicador_user_id")       // quem indicou (recebe a comissão)
  indicadoUserId  String    @unique @map("indicado_user_id") // 1 indicação por indicado
  status          String    @default("PENDENTE")            // PENDENTE | EFETIVADO | CANCELADO
  // Efetivação (marcada à mão pelo admin)
  efetivadoEm     DateTime? @map("efetivado_em")
  assinaturaValor Int?      @map("assinatura_valor")        // centavos (ex.: 2700 = R$27)
  // Comissão
  comissaoValor   Int?      @map("comissao_valor")          // centavos (ex.: 500 = R$5)
  comissaoStatus  String?   @map("comissao_status")         // PENDENTE | PAGA | CANCELADA
  comissaoPagaEm  DateTime? @map("comissao_paga_em")
  notas           String?
  criadoEm        DateTime  @default(now()) @map("criado_em")
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em")

  indicador User @relation("IndicacoesFeitas", fields: [indicadorUserId], references: [id], onDelete: Cascade)
  indicado  User @relation("IndicacaoRecebida", fields: [indicadoUserId], references: [id], onDelete: Cascade)

  @@index([indicadorUserId])
  @@index([status])
  @@map("referrals")
}

/// Papel de acesso, POR ORGANIZACAO.
///
/// Antes desta versao `Role` nao tinha `organizationId` e `nome` era unico
/// GLOBALMENTE: duas organizacoes nao conseguiam ter duas linhas chamadas
/// "gestor" — elas compartilhavam a MESMA linha. Consequencia: um master do
/// cliente A editava as permissoes do papel e mudava o que os usuarios do
/// cliente B podiam fazer.
///
/// `Permission` continua global de proposito: e catalogo fixo de capacidades
/// do sistema, nao dado de cliente. O que passa a ser por organizacao e o
/// AMARRADO entre papel e permissao.
model Role {
  id              String           @id @default(uuid())
  organizationId  String           @map("organization_id")
  nome            String
  descricao       String?
  isMaster        Boolean          @default(false) @map("is_master")
  nivel           Int              @default(0)
  criadoEm        DateTime         @default(now()) @map("criado_em")
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, nome])
  @@index([organizationId])
  @@map("roles")
}

model UserRole {
  userId         String   @map("user_id")
  roleId         String   @map("role_id")
  atribuidoPorId String?  @map("atribuido_por")
  atribuidoEm    DateTime @default(now()) @map("atribuido_em")
  user           User     @relation("UserToRoles", fields: [userId], references: [id], onDelete: Cascade)
  role           Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  atribuidoPor   User?    @relation("AtribuidoPor", fields: [atribuidoPorId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id                      String                   @id @default(uuid())
  recurso                 String
  acao                    String
  descricao               String?
  criadoEm                DateTime                 @default(now()) @map("criado_em")
  rolePermissions         RolePermission[]
  userPermissionOverrides UserPermissionOverride[]

  @@unique([recurso, acao])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermissionOverride {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  permissionId String     @map("permission_id")
  conceder     Boolean    @default(true)
  criadoEm     DateTime   @default(now()) @map("criado_em")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permission_overrides")
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  ipAddress String?  @map("ip_address")
  expiraEm  DateTime @map("expira_em")
  criadoEm  DateTime @default(now()) @map("criado_em")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("user_sessions")
}

// ── Agenda ────────────────────────────────────────────────────────────────────

model Event {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  userId         String      @map("user_id")
  criadoPorId    String      @map("created_by")
  titulo         String
  descricao      String?
  tipo           EventType   @default(PESSOAL)
  cor            String?
  inicio         DateTime
  fim            DateTime?
  diaTodo        Boolean     @default(false) @map("dia_todo")
  origemTipo     String?     @map("origem_tipo")
  origemId       String?     @map("origem_id")
  confirmado     Boolean     @default(true)
  recorrencia    Recurrence? @map("recorrencia")
  recorrenciaFim DateTime?   @map("recorrencia_fim")
  local          String?
  ata            String?     @db.Text

  // ── Proveniência de calendário externo (Outlook / futuro Google) ────────────
  // A tabela Event é a AGENDA UNIFICADA. Um evento nativo tem provider="internal".
  // Um evento espelhado do Outlook tem provider="microsoft" + os campos externos.
  // Nenhum consumidor de disponibilidade precisa saber a origem — só lê Event.
  provider           String?   @default("internal")
  connectionId       String?   @map("connection_id")
  externalId         String?   @map("external_id")
  externalCalendarId String?   @map("external_calendar_id")
  externalEtag       String?   @map("external_etag")
  // Hash do conteúdo já sincronizado. Serve para (a) evitar loop de eco — o
  // writeback só dispara se o hash mudou de fato — e (b) detectar mudança real
  // vinda do Graph. Ver calendar-sync.service.ts.
  syncHash           String?   @map("sync_hash")
  syncedAt           DateTime? @map("synced_at")
  // Marca evento externo cancelado no provedor sem apagar histórico local.
  externalCancelled  Boolean   @default(false) @map("external_cancelled")

  criadoEm     DateTime            @default(now()) @map("criado_em")
  atualizadoEm DateTime            @updatedAt @map("atualizado_em")
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                @relation("EventOwner", fields: [userId], references: [id])
  criadoPor    User                @relation("EventCreator", fields: [criadoPorId], references: [id])
  participants EventParticipant[]
  connection   CalendarConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  // Referência ESTÁVEL do evento externo: (conexão, id do Graph) é único.
  // Impede duplicidade quando webhook e reconciliação chegam ao mesmo evento.
  @@unique([connectionId, externalId])
  @@index([organizationId, inicio])
  @@index([userId, inicio])
  @@index([criadoPorId])
  @@index([provider, externalId])
  @@map("events")
}

model EventParticipant {
  id      String @id @default(uuid())
  eventId String @map("event_id")
  userId  String @map("user_id")
  status  String @default("pendente")
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_participants")
}

// ── Integração de calendário externo (Microsoft 365 / futuro Google) ───────────
//
// CalendarConnection = o vínculo de UM usuário com UMA conta de provedor. Guarda
// os tokens (cifrados via common/vault.ts) e o estado da sincronização. O
// isolamento é por (userId, provider): a agenda do usuário A nunca cruza com a
// do B. Os eventos em si moram na tabela Event (agenda unificada), apontando de
// volta por Event.connectionId.

enum CalendarProvider {
  microsoft
  google
}

enum CalendarConnectionStatus {
  connected // vínculo ativo, tokens válidos
  syncing // sincronização inicial/completa em andamento
  synced // em dia
  error // falha transitória de sync (ver lastError)
  disconnected // usuário desconectou
  reauth_required // refresh token inválido/revogado — precisa reconectar
}

model CalendarConnection {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  provider       CalendarProvider @default(microsoft)

  // Identidade no provedor (descoberta via Graph /me).
  providerAccountId String? @map("provider_account_id")
  providerTenantId  String? @map("provider_tenant_id")
  providerEmail     String? @map("provider_email")

  // Calendário conectado (v1: calendário principal). Estruturado para múltiplos.
  externalCalendarId   String? @map("external_calendar_id")
  externalCalendarName String? @map("external_calendar_name")

  status CalendarConnectionStatus @default(connected)

  // Tokens SEMPRE cifrados (v1:iv:tag:ct). Nunca em texto puro, nunca em log.
  accessTokenEnc  String?   @map("access_token_enc") @db.Text
  refreshTokenEnc String?   @map("refresh_token_enc") @db.Text
  tokenExpiresAt  DateTime? @map("token_expires_at")
  scope           String?   @db.Text

  // Sincronização incremental do Graph (delta query).
  deltaLink  String?   @map("delta_link") @db.Text
  lastSyncAt DateTime? @map("last_sync_at")
  lastError  String?   @map("last_error") @db.Text

  // Política de saída: se true, eventos criados no Orkiestri sobem ao Outlook.
  pushEnabled Boolean @default(true) @map("push_enabled")
  syncEnabled Boolean @default(true) @map("sync_enabled")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions CalendarSubscription[]
  events        Event[]

  // Um usuário tem no máximo uma conexão por provedor.
  @@unique([userId, provider])
  @@index([organizationId])
  @@index([status])
  @@map("calendar_connections")
}

// Configuração do app do provedor (credenciais do App Registration), editável
// por tela em vez de env. Escopo: organizationId nulo = PADRÃO DA PLATAFORMA
// (herdado por quem não tem o seu); com organizationId = a org traz o próprio
// app (bring-your-own). Resolução em runtime: org → plataforma → env.
// O client secret é cifrado (vault) e NUNCA volta ao frontend.
model CalendarProviderConfig {
  id             String           @id @default(uuid())
  organizationId String?          @map("organization_id")
  provider       CalendarProvider @default(microsoft)

  clientId        String? @map("client_id")
  tenantId        String? @map("tenant_id")
  clientSecretEnc String? @map("client_secret_enc") @db.Text
  // Override do redirect/webhook quando o domínio não é derivável do ambiente.
  redirectUri     String? @map("redirect_uri")
  webhookUrl      String? @map("webhook_url")
  enabled         Boolean @default(true)

  atualizadoPorId String?  @map("atualizado_por")
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Uma config por (org, provider); a linha de plataforma tem organizationId nulo.
  // (unicidade da linha de plataforma garantida por índice parcial na migration.)
  @@unique([organizationId, provider])
  @@map("calendar_provider_configs")
}

// Assinatura de webhook (Change Notification) do Microsoft Graph. Tem ciclo de
// vida próprio: expira em ~3 dias e é renovada por scheduler. clientState é um
// segredo verificado em cada notificação recebida.
model CalendarSubscription {
  id             String   @id @default(uuid())
  connectionId   String   @map("connection_id")
  subscriptionId String   @unique @map("subscription_id")
  resource       String
  clientState    String   @map("client_state")
  expiresAt      DateTime @map("expires_at")
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  connection CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([expiresAt])
  @@map("calendar_subscriptions")
}

// ── CRM ───────────────────────────────────────────────────────────────────────

model Cliente {
  id               String            @id @default(uuid())
  organizationId   String            @map("organization_id")
  nome             String
  empresa          String?
  cargo            String?
  email            String?
  telefone         String?
  cnpj             String?
  site             String?
  cidade           String?
  estado           String?
  segmento         String?
  origem           String?
  statusLead       String            @default("ativo") @map("status_lead")
  notas            String?           @db.Text
  ativo            Boolean           @default(true)
  responsavelId    String?           @map("responsavel_id")
  saudeScore       Int               @default(100) @map("saude_score")
  portalToken      String?           @unique @map("portal_token")
  // Pipeline / Oportunidade
  tenantOrgId      String?           @unique @map("tenant_org_id")
  valorEstimado    Float?            @map("valor_estimado")
  probabilidade    Int?
  dataFechamento   DateTime?         @map("data_fechamento")
  criadoEm         DateTime          @default(now()) @map("criado_em")
  atualizadoEm     DateTime          @updatedAt @map("atualizado_em")
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  responsavel      User?             @relation("ClienteResponsavel", fields: [responsavelId], references: [id])
  projetos         Project[]
  chamados         Chamado[]
  contratos        Contrato[]
  faturas          Fatura[]
  timeline         ClienteTimeline[]
  cadastroRequests CadastroRequest[]

  @@index([organizationId])
  @@map("clientes")
}

model Contrato {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  numero         Int?
  titulo         String          @default("")
  clienteId      String          @map("cliente_id")
  tipo           String          @default("servico")
  plano          String?
  status         String          @default("vigente")
  slaHoras       Int?            @map("sla_horas")
  vigenciaInicio DateTime?       @map("vigencia_inicio")
  vigenciaFim    DateTime?       @map("vigencia_fim")
  valor          Float?
  responsavelId  String?         @map("responsavel_id")
  ativo          Boolean         @default(true)
  observacoes    String?         @db.Text
  criadoEm       DateTime        @default(now()) @map("criado_em")
  atualizadoEm   DateTime        @updatedAt @map("atualizado_em")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cliente        Cliente         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  responsavel    User?           @relation("ContratoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  faturas        Fatura[]
  anexos         ContratoAnexo[]

  @@index([organizationId])
  @@index([clienteId])
  @@index([status])
  @@map("contratos")
}

model ClienteTimeline {
  id             String   @id @default(uuid())
  clienteId      String   @map("cliente_id")
  tipo           String
  titulo         String
  descricao      String?  @db.Text
  referenciaTipo String?  @map("referencia_tipo")
  referenciaId   String?  @map("referencia_id")
  userId         String?  @map("user_id")
  criadoEm       DateTime @default(now()) @map("criado_em")
  cliente        Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  user           User?    @relation(fields: [userId], references: [id])

  @@index([clienteId, criadoEm])
  @@map("cliente_timeline")
}

// ── Service Desk ──────────────────────────────────────────────────────────────

model SlaRegra {
  id              String       @id @default(uuid())
  organizationId  String       @map("organization_id")
  nome            String
  prioridade      String
  categoria       String?
  prazoRespostaH  Int          @default(4) @map("prazo_resposta_h")
  prazoResolucaoH Int          @default(24) @map("prazo_resolucao_h")
  ativo           Boolean      @default(true)
  criadoEm        DateTime     @default(now()) @map("criado_em")
  atualizadoEm    DateTime     @updatedAt @map("atualizado_em")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chamados        Chamado[]

  @@unique([organizationId, prioridade, categoria])
  @@map("sla_regras")
}

model Chamado {
  id                 String               @id @default(uuid())
  organizationId     String               @map("organization_id")
  numero             Int                  @default(autoincrement())
  titulo             String
  descricao          String               @db.Text
  status             String               @default("aberto")
  prioridade         String               @default("media")
  categoria          String?
  tags               String?
  solicitanteId      String               @map("solicitante_id")
  atendenteId        String?              @map("atendente_id")
  clienteId          String?              @map("cliente_id")
  slaHoras           Int?                 @map("sla_horas")
  horasEstimadas     Float?               @map("horas_estimadas")
  skillRequeridaId   String?              @map("skill_requerida_id")
  nivelMinimo        String?              @map("nivel_minimo")
  slaRegraId         String?              @map("sla_regra_id")
  slaRespostaAt      DateTime?            @map("sla_resposta_at")
  slaResolucaoAt     DateTime?            @map("sla_resolucao_at")
  primeiraRespostaEm DateTime?            @map("primeira_resposta_em")
  resolvidoEm        DateTime?            @map("resolvido_em")
  fechadoEm          DateTime?            @map("fechado_em")
  avaliacao          Int?
  avaliacaoNota      String?              @map("avaliacao_nota") @db.Text
  criadoEm           DateTime             @default(now()) @map("criado_em")
  atualizadoEm       DateTime             @updatedAt @map("atualizado_em")
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  solicitante        User                 @relation("ChamadoSolicitante", fields: [solicitanteId], references: [id])
  atendente          User?                @relation("ChamadoAtendente", fields: [atendenteId], references: [id])
  cliente            Cliente?             @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  slaRegra           SlaRegra?            @relation(fields: [slaRegraId], references: [id], onDelete: SetNull)
  comentarios        ChamadoComentario[]
  apontamentos       ApontamentoHoras[]
  auditorias         ChamadoAuditoria[]
  anexos             ChamadoAnexo[]
  watchers           ChamadoWatcher[]
  subtasks           ChamadoSubtask[]
  linksFrom          ChamadoLink[]        @relation("LinkFrom")
  linksTo            ChamadoLink[]        @relation("LinkTo")
  customValues       ChamadoCustomValue[]
  skillRequerida     Skill?               @relation("ChamadoSkill", fields: [skillRequeridaId], references: [id], onDelete: SetNull)
  /// Quem atribuiu o chamado. Resgatado de homologacao em 08/2026.
  atribuidoPorId     String?              @map("atribuido_por_id")
  /// O que trava o chamado e desde quando. So valem em status=aguardando.
  aguardandoMotivo   String?              @map("aguardando_motivo")
  aguardandoDesde    DateTime?            @map("aguardando_desde")
  /// Veiculo do chamado. Presente = o chamado e de frota e pode virar OS.
  veiculoId          String?              @map("veiculo_id")
  /// Condicao do veiculo RELATADA por quem abriu: "inoperante" ou
  /// "operando_com_avaria".
  ///
  /// Serve a uma pergunta de quem vai atender: da para esperar? Veiculo parado
  /// na estrada e veiculo rodando com barulho no freio geram o mesmo chamado e
  /// exigem reacoes diferentes.
  ///
  /// NAO e estado do veiculo. O farol em Frotas continua vindo do modulo de
  /// Frotas — isto e relato, nao medicao, e misturar as duas coisas faria um
  /// chamado mal preenchido mudar a operacao da frota.
  condicaoVeiculo    String?              @map("condicao_veiculo")
  atribuidoPor       User?                @relation("ChamadoAtribuidor", fields: [atribuidoPorId], references: [id], onDelete: SetNull)
  veiculo            Veiculo?             @relation("ChamadoVeiculo", fields: [veiculoId], references: [id], onDelete: SetNull)
  manutencoes        ManutencaoVeiculo[]  @relation("ManutencaoChamado")

  @@index([organizationId, status])
  @@index([skillRequeridaId])
  @@index([organizationId, prioridade])
  @@index([solicitanteId])
  @@index([atendenteId])
  @@index([organizationId, status, atendenteId])
  @@map("chamados")
}

// ── Anexos de Chamado ──────────────────────────────────────────────────────────
model ChamadoAnexo {
  id           String   @id @default(uuid())
  chamadoId    String   @map("chamado_id")
  uploaderId   String   @map("uploader_id")
  nomeOriginal String   @map("nome_original")
  nomeArquivo  String   @map("nome_arquivo")
  mimeType     String   @map("mime_type")
  tamanhoBytes Int      @map("tamanho_bytes")
  criadoEm     DateTime @default(now()) @map("criado_em")

  chamado  Chamado @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  uploader User    @relation("AnexoUploader", fields: [uploaderId], references: [id])

  @@index([chamadoId])
  @@map("chamado_anexos")
}

// ── Templates de Chamado ───────────────────────────────────────────────────────
model ChamadoTemplate {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  criadoPorId    String   @map("criado_por_id")
  nome           String
  titulo         String
  descricao      String?  @db.Text
  prioridade     String   @default("media")
  categoria      String?
  tags           String?
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  organization Organization @relation("OrgChamadoTemplates", fields: [organizationId], references: [id], onDelete: Cascade)
  criadoPor    User         @relation("ChamadoTemplateCriador", fields: [criadoPorId], references: [id])

  @@index([organizationId])
  @@map("chamado_templates")
}

model ChamadoComentario {
  id        String   @id @default(uuid())
  chamadoId String   @map("chamado_id")
  userId    String   @map("user_id")
  texto     String   @db.Text
  interno   Boolean  @default(false)
  criadoEm  DateTime @default(now()) @map("criado_em")
  chamado   Chamado  @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chamado_comentarios")
}

// ── Watchers / Seguidores ─────────────────────────────────────────────────────
// Usuarios que escolheram acompanhar um chamado sem ser solicitante/atendente.
// Recebem notificacoes em todas as interacoes publicas.
model ChamadoWatcher {
  id        String   @id @default(uuid())
  chamadoId String   @map("chamado_id")
  userId    String   @map("user_id")
  criadoEm  DateTime @default(now()) @map("criado_em")
  chamado   Chamado  @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  user      User     @relation("ChamadoWatcher", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chamadoId, userId])
  @@index([userId])
  @@map("chamado_watchers")
}

// ── Subtasks / Checklist ─────────────────────────────────────────────────────
model ChamadoSubtask {
  id          String    @id @default(uuid())
  chamadoId   String    @map("chamado_id")
  titulo      String
  concluido   Boolean   @default(false)
  assigneeId  String?   @map("assignee_id")
  ordem       Int       @default(0)
  criadoEm    DateTime  @default(now()) @map("criado_em")
  concluidoEm DateTime? @map("concluido_em")
  chamado     Chamado   @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  assignee    User?     @relation("ChamadoSubtask", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([chamadoId, ordem])
  @@map("chamado_subtasks")
}

// ── Links entre chamados ─────────────────────────────────────────────────────
// tipo: RELACIONADO | BLOQUEIA | BLOQUEADO_POR | DUPLICADO_DE
model ChamadoLink {
  id            String   @id @default(uuid())
  fromChamadoId String   @map("from_chamado_id")
  toChamadoId   String   @map("to_chamado_id")
  tipo          String
  criadoEm      DateTime @default(now()) @map("criado_em")
  criadoPorId   String?  @map("criado_por_id")
  fromChamado   Chamado  @relation("LinkFrom", fields: [fromChamadoId], references: [id], onDelete: Cascade)
  toChamado     Chamado  @relation("LinkTo", fields: [toChamadoId], references: [id], onDelete: Cascade)
  criadoPor     User?    @relation("ChamadoLinkCreator", fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@unique([fromChamadoId, toChamadoId, tipo])
  @@index([fromChamadoId])
  @@index([toChamadoId])
  @@map("chamado_links")
}

// ── Custom fields por categoria de chamado ───────────────────────────────────
// tipo: TEXT | TEXTAREA | NUMBER | DATE | SELECT | BOOLEAN
model ChamadoCustomField {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  categoria      String? // null = aplica a todas as categorias
  label          String
  tipo           String
  obrigatorio    Boolean              @default(false)
  ordem          Int                  @default(0)
  opcoesJson     Json?                @map("opcoes_json")
  ativo          Boolean              @default(true)
  criadoEm       DateTime             @default(now()) @map("criado_em")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values         ChamadoCustomValue[]

  @@index([organizationId, categoria])
  @@map("chamado_custom_fields")
}

model ChamadoCustomValue {
  id        String             @id @default(uuid())
  chamadoId String             @map("chamado_id")
  fieldId   String             @map("field_id")
  valor     String             @db.Text
  chamado   Chamado            @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  field     ChamadoCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([chamadoId, fieldId])
  @@index([chamadoId])
  @@map("chamado_custom_values")
}

// Histórico/auditoria de chamados — registra ações importantes (criação, claim,
// atribuição, mudanças de status, transferências). Usado pela UI de timeline.
model ChamadoAuditoria {
  id        String   @id @default(uuid())
  chamadoId String   @map("chamado_id")
  userId    String?  @map("user_id")
  acao      String
  de        String?
  para      String?
  metadata  Json?
  criadoEm  DateTime @default(now()) @map("criado_em")
  chamado   Chamado  @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([chamadoId])
  @@index([userId])
  @@index([acao])
  @@map("chamado_auditoria")
}

// ── Projetos ──────────────────────────────────────────────────────────────────

model Project {
  id                   String                @id @default(uuid())
  organizationId       String                @map("organization_id")
  criadoPorId          String                @map("created_by")
  tipo                 ProjectTipo           @default(PROJETO)
  clienteId            String?               @map("cliente_id")
  titulo               String
  descricao            String?
  status               ProjectStatus         @default(PLANEJAMENTO)
  prioridade           Priority              @default(MEDIA)
  valor                Float?
  dataInicio           DateTime?             @map("data_inicio")
  dataFim              DateTime?             @map("data_fim")
  progressoPct         Int                   @default(0) @map("progresso_pct")
  cor                  String?
  criadoEm             DateTime              @default(now()) @map("criado_em")
  atualizadoEm         DateTime              @updatedAt @map("atualizado_em")
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  criadoPor            User                  @relation("ProjectOwner", fields: [criadoPorId], references: [id])
  cliente              Cliente?              @relation(fields: [clienteId], references: [id])
  members              ProjectMember[]
  milestones           Milestone[]
  tasks                Task[]
  ReservaVeiculo       ReservaVeiculo[]
  complianceObrigacoes ComplianceObrigacao[]
  anexos               ProjectAnexo[]

  @@index([organizationId, status])
  @@index([criadoPorId])
  @@index([tipo])
  @@map("projects")
}

/// Anexo de projeto — proposta, ata, escopo assinado, o que sustenta a decisão.
///
/// Vive em volume nomeado sob `/app/secure/project-docs`, FORA de
/// `/app/uploads`: aquele é servido estaticamente pelo nginx, e anexo de
/// projeto pode conter valor, contrato e nome de cliente. Só sai pelo endpoint
/// autenticado de download. Mesmo desenho de ComplianceArquivo e dos
/// documentos do People.
model ProjectAnexo {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  projectId      String @map("project_id")

  titulo       String
  nomeOriginal String  @map("nome_original")
  /// Caminho relativo dentro da raiz segura. Nunca absoluto, nunca URL.
  arquivoRef   String  @map("arquivo_ref")
  mime         String?
  tamanho      Int?

  criadoPorId String?   @map("criado_por_id")
  deletedAt   DateTime? @map("deleted_at")
  criadoEm    DateTime  @default(now()) @map("criado_em")

  organization Organization @relation("OrgProjectAnexos", fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  criadoPor    User?        @relation("ProjectAnexoAutor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@index([projectId, deletedAt])
  @@index([organizationId])
  @@map("project_anexos")
}

model ProjectMember {
  projectId    String   @map("project_id")
  userId       String   @map("user_id")
  papel        String   @default("membro")
  adicionadoEm DateTime @default(now()) @map("adicionado_em")
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_members")
}

model Milestone {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  titulo    String
  descricao String?
  dataAlvo  DateTime @map("data_alvo")
  concluido Boolean  @default(false)
  criadoEm  DateTime @default(now()) @map("criado_em")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@map("milestones")
}

model Task {
  id             String        @id @default(uuid())
  projectId      String        @map("project_id")
  milestoneId    String?       @map("milestone_id")
  assigneeId     String?       @map("assignee_id")
  criadoPorId    String        @map("created_by")
  titulo         String
  descricao      String?
  status         TaskStatus    @default(A_FAZER)
  prioridade     Priority      @default(MEDIA)
  dataInicio     DateTime?     @map("data_inicio")
  dataVencimento DateTime?     @map("data_vencimento")
  horasEstimadas Float?        @map("horas_estimadas")
  criadoEm       DateTime      @default(now()) @map("criado_em")
  atualizadoEm   DateTime      @updatedAt @map("atualizado_em")
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone      Milestone?    @relation(fields: [milestoneId], references: [id])
  assignee       User?         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  criadoPor      User          @relation("TaskCreator", fields: [criadoPorId], references: [id])
  comments       TaskComment[]

  @@index([projectId, status])
  @@index([assigneeId])
  @@map("tasks")
}

model TaskComment {
  id       String   @id @default(uuid())
  taskId   String   @map("task_id")
  userId   String   @map("user_id")
  conteudo String
  criadoEm DateTime @default(now()) @map("criado_em")
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@map("task_comments")
}

// ── Keep / Notes ──────────────────────────────────────────────────────────────

model Note {
  id             String             @id @default(uuid())
  organizationId String             @map("organization_id")
  userId         String             @map("user_id")
  titulo         String?
  conteudo       String?
  cor            String?
  fixado         Boolean            @default(false)
  arquivado      Boolean            @default(false)
  lixeira        Boolean            @default(false)
  tipo           NoteType           @default(TEXTO)
  ordem          Int                @default(0)
  criadoEm       DateTime           @default(now()) @map("criado_em")
  atualizadoEm   DateTime           @updatedAt @map("atualizado_em")
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id])
  labels         NoteLabelMap[]
  collaborators  NoteCollaborator[]
  checklists     Checklist[]

  @@index([organizationId, userId, arquivado, lixeira])
  @@map("notes")
}

model NoteLabel {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  userId         String         @map("user_id")
  nome           String
  cor            String?
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id])
  notes          NoteLabelMap[]

  @@unique([organizationId, userId, nome])
  @@map("note_labels")
}

model NoteLabelMap {
  noteId  String    @map("note_id")
  labelId String    @map("label_id")
  note    Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  label   NoteLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([noteId, labelId])
  @@map("note_label_map")
}

model NoteCollaborator {
  noteId    String @map("note_id")
  userId    String @map("user_id")
  permissao String @default("leitura")
  note      Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([noteId, userId])
  @@map("note_collaborators")
}

model Checklist {
  id     String          @id @default(uuid())
  noteId String          @map("note_id")
  titulo String?
  ordem  Int             @default(0)
  note   Note            @relation(fields: [noteId], references: [id], onDelete: Cascade)
  items  ChecklistItem[]

  @@map("checklists")
}

model ChecklistItem {
  id             String      @id @default(uuid())
  checklistId    String      @map("checklist_id")
  assigneeId     String?     @map("assignee_id")
  descricao      String
  concluido      Boolean     @default(false)
  dataVencimento DateTime?   @map("data_vencimento")
  ordem          Int         @default(0)
  criadoEm       DateTime    @default(now()) @map("criado_em")
  checklist      Checklist   @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  assignee       User?       @relation("ChecklistAssignee", fields: [assigneeId], references: [id])
  dailyTasks     DailyTask[]

  @@map("checklist_items")
}

model DailyTask {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  checklistItemId String?        @map("checklist_item_id")
  titulo          String
  concluido       Boolean        @default(false)
  data            DateTime       @db.Date
  tipo            String         @default("TAREFA")
  prioridade      Int            @default(0)
  criadoEm        DateTime       @default(now()) @map("criado_em")
  user            User           @relation(fields: [userId], references: [id])
  checklistItem   ChecklistItem? @relation(fields: [checklistItemId], references: [id])

  @@index([userId, data])
  @@map("daily_tasks")
}

// ── Notifications / Audit ─────────────────────────────────────────────────────

model Notification {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  tipo           String
  titulo         String
  mensagem       String?
  referenciaTipo String?  @map("referencia_tipo")
  referenciaId   String?  @map("referencia_id")
  lida           Boolean  @default(false)
  /// Módulo de origem, para a preferência por módulo. Migration notification_modulo.
  modulo         String?
  criadoEm       DateTime @default(now()) @map("criado_em")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lida])
  @@index([tipo])
  @@index([criadoEm])
  @@map("notifications")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String?      @map("user_id")
  modulo         String?
  tabela         String
  registroId     String       @map("registro_id")
  acao           String
  descricao      String?
  dados          Json?
  ip             String?
  criadoEm       DateTime     @default(now()) @map("criado_em")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, criadoEm(sort: Desc)])
  @@index([userId])
  @@index([tabela, acao])
  @@map("audit_log")
}

// ── Automações ────────────────────────────────────────────────────────────────

model Automacao {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  nome           String
  descricao      String?
  trigger        String
  condicoes      Json                @default("[]")
  acoes          Json                @default("[]")
  ativo          Boolean             @default(true)
  totalExecucoes Int                 @default(0) @map("total_execucoes")
  ultimaExecucao DateTime?           @map("ultima_execucao")
  criadoEm       DateTime            @default(now()) @map("criado_em")
  atualizadoEm   DateTime            @updatedAt @map("atualizado_em")
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  execucoes      AutomacaoExecucao[]

  @@index([organizationId])
  @@map("automacoes")
}

model AutomacaoExecucao {
  id          String    @id @default(uuid())
  automacaoId String    @map("automacao_id")
  trigger     String
  contextId   String    @map("context_id")
  resultado   String    @default("sucesso")
  detalhes    Json?
  criadoEm    DateTime  @default(now()) @map("criado_em")
  automacao   Automacao @relation(fields: [automacaoId], references: [id], onDelete: Cascade)

  @@index([automacaoId])
  @@index([criadoEm(sort: Desc)])
  @@map("automacao_execucoes")
}

// ── Webhooks ──────────────────────────────────────────────────────────────────

model Webhook {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  nome           String
  descricao      String?
  url            String
  evento         String
  headers        Json         @default("{}")
  secret         String?
  ativo          Boolean      @default(true)
  totalEnvios    Int          @default(0) @map("total_envios")
  ultimoEnvio    DateTime?    @map("ultimo_envio")
  ultimoStatus   Int?         @map("ultimo_status")
  criadoEm       DateTime     @default(now()) @map("criado_em")
  atualizadoEm   DateTime     @updatedAt @map("atualizado_em")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  logs           WebhookLog[]

  @@index([organizationId, evento])
  @@index([evento, ativo])
