model DocumentoVeiculo {
  id              String           @id @default(uuid())
  organizationId  String           @map("organization_id")
  veiculoId       String           @map("veiculo_id")
  tipo            String           @default("crlv")
  /// UF onde o veiculo esta registrado. Escolhida a mao: e ela que decide a
  /// regra de vencimento do licenciamento, e o DETRAN emissor do CRLV nem
  /// sempre e o estado de registro.
  uf              String?          // UF de registro
  numero          String?
  descricao       String?
  dataEmissao     DateTime?        @map("data_emissao")
  dataVencimento  DateTime?        @map("data_vencimento")
  valor           Float?
  arquivoUrl      String?          @map("arquivo_url")
  status          String           @default("vigente")
  observacoes     String?          @db.Text
  criadoPorId     String?          @map("criado_por_id")
  atualizadoPorId String?          @map("atualizado_por_id")
  deletedAt       DateTime?        @map("deleted_at")
  criadoEm        DateTime         @default(now()) @map("criado_em")
  atualizadoEm    DateTime         @updatedAt @map("atualizado_em")
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  veiculo         Veiculo          @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  anexos          DocumentoAnexo[]

  @@index([organizationId, deletedAt])
  @@index([veiculoId])
  @@index([organizationId, dataVencimento])
  @@map("documentos_veiculo")
}

model DocumentoAnexo {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  documentoId    String           @map("documento_id")
  nomeArquivo    String           @map("nome_arquivo")
  /// Onde o arquivo mora: "uploads" (legado) ou "secure". Os anexos ja
  /// gravados estao em /app/uploads, e mudar o padrao os tornaria ilegiveis;
  /// por isso o default preserva o passado e so o CRLV nasce em secure.
  area           String           @default("uploads")
  nomeOriginal   String           @map("nome_original")
  mime           String?
  tamanho        Int?
  criadoPorId    String?          @map("criado_por_id")
  deletedAt      DateTime?        @map("deleted_at")
  criadoEm       DateTime         @default(now()) @map("criado_em")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documento      DocumentoVeiculo @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@index([documentoId, deletedAt])
  @@map("documento_anexos")
}

