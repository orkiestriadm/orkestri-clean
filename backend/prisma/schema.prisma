  organizationId  String    @map("organization_id")
  nome            String
  fornecedor      String?
  categoria       String    @default("outro")
  cargaHoraria    Int?      @map("carga_horaria")
  descricao       String?
  /// Meses de validade. Nulo = certificação não expira.
