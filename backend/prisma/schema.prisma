// ── People Fase 6: Benefícios ──────────────────────────────────────────────
// Catálogo da organização, separado da concessão à pessoa. Ver a migration
// 20260729000001 para o porquê da separação.

model Benefit {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  nome            String
  categoria       String    @default("outro")
  descricao       String?
  /// Nulo de propósito: plano de saúde varia por faixa e dependente.
  valorReferencia Float?    @map("valor_referencia")
  ativo           Boolean   @default(true)
  criadoEm        DateTime  @default(now()) @map("criado_em")
  criadoPorId     String?   @map("criado_por_id")
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em")
  atualizadoPorId String?   @map("atualizado_por_id")
  excluidoEm      DateTime? @map("excluido_em")

  organization Organization          @relation("OrgBenefits", fields: [organizationId], references: [id], onDelete: Cascade)
  concessoes   CollaboratorBenefit[]

  @@unique([organizationId, nome])
  @@index([organizationId, ativo])
  @@map("benefits")
}

model CollaboratorBenefit {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  collaboratorId  String    @map("collaborator_id")
  benefitId       String    @map("benefit_id")
  inicio          DateTime
  /// Nulo = vigente. Encerrar preenche a data; a linha nunca é apagada.
  fim             DateTime?
  valor           Float?
  observacoes     String?
  criadoEm        DateTime  @default(now()) @map("criado_em")
  criadoPorId     String?   @map("criado_por_id")
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em")
  atualizadoPorId String?   @map("atualizado_por_id")

  organization Organization @relation("OrgCollabBenefits", fields: [organizationId], references: [id], onDelete: Cascade)
  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  benefit      Benefit      @relation(fields: [benefitId], references: [id], onDelete: Restrict)

  @@unique([collaboratorId, benefitId, inicio])
  @@index([collaboratorId])
  @@index([organizationId])
  @@index([benefitId])
  @@map("collaborator_benefits")
}

// ── People Fase 7: Treinamentos e desempenho ───────────────────────────────

model TrainingCourse {
