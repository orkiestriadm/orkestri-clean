  @@index([webhookId, criadoEm(sort: Desc)])
  @@map("webhook_logs")
}

// ── Ativos ────────────────────────────────────────────────────────────────────

model CategoriaAtivo {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  nome           String
  descricao      String?
  icone          String       @default("monitor")
  cor            String       @default("#7c3aed")
  ativo          Boolean      @default(true)
  criadoEm       DateTime     @default(now()) @map("criado_em")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ativos         Ativo[]

  @@unique([organizationId, nome])
  @@map("categorias_ativo")
}

model Ativo {
  id              String               @id @default(uuid())
  organizationId  String               @map("organization_id")
  codigo          String
  nome            String
  descricao       String?
  categoriaId     String?              @map("categoria_id")
  status          String               @default("ativo")
  marca           String?
  modelo          String?
  numeroSerie     String?              @map("numero_serie")
  localizacao     String?
  responsavelId   String?              @map("responsavel_id")
  setorId         String?              @map("setor_id")
  dataAquisicao   DateTime?            @map("data_aquisicao")
  valorAquisicao  Float?               @map("valor_aquisicao")
  dataGarantiaFim DateTime?            @map("data_garantia_fim")
  observacoes     String?              @db.Text
  ip              String?
  monitorar       Boolean              @default(false)
  online          Boolean?
  ultimoPing      DateTime?            @map("ultimo_ping")
  latenciaMs      Int?                 @map("latencia_ms")
  criadoEm        DateTime             @default(now()) @map("criado_em")
  atualizadoEm    DateTime             @updatedAt @map("atualizado_em")
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoria       CategoriaAtivo?      @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  responsavel     User?                @relation("AtivoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  setor           Setor?               @relation(fields: [setorId], references: [id], onDelete: SetNull)
  transferencias  TransferenciaAtivo[]
  pingLogs        PingLog[]
  veiculo         Veiculo?

  @@unique([organizationId, codigo])
  @@index([organizationId, status])
  @@index([organizationId, monitorar])
  @@index([responsavelId])
  @@map("ativos")
}

model PingLog {
  id             String       @id @default(uuid())
  ativoId        String       @map("ativo_id")
  organizationId String       @map("organization_id")
  online         Boolean
  latenciaMs     Int?         @map("latencia_ms")
  erro           String?
  criadoEm       DateTime     @default(now()) @map("criado_em")
  ativo          Ativo        @relation(fields: [ativoId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([ativoId, criadoEm(sort: Desc)])
  @@index([organizationId, criadoEm(sort: Desc)])
  @@map("ping_logs")
}

model TransferenciaAtivo {
  id                String   @id @default(uuid())
  ativoId           String   @map("ativo_id")
  deResponsavelId   String?  @map("de_responsavel_id")
  paraResponsavelId String?  @map("para_responsavel_id")
  deSetorId         String?  @map("de_setor_id")
  paraSetorId       String?  @map("para_setor_id")
  motivo            String?
  realizadoPorId    String   @map("realizado_por_id")
  criadoEm          DateTime @default(now()) @map("criado_em")
  ativo             Ativo    @relation(fields: [ativoId], references: [id], onDelete: Cascade)
  deResponsavel     User?    @relation("TransfDe", fields: [deResponsavelId], references: [id], onDelete: SetNull)
  paraResponsavel   User?    @relation("TransfPara", fields: [paraResponsavelId], references: [id], onDelete: SetNull)
  realizadoPor      User     @relation("TransfPor", fields: [realizadoPorId], references: [id])

  @@index([ativoId])
  @@map("transferencias_ativo")
}

// ── Gestão de Frotas ──────────────────────────────────────────────────────────
//
// Cadastro central: Veiculo. Todos os sub-cadastros vinculam-se por veiculoId.
// Padrão comum: exclusão lógica (deletedAt), auditoria de usuário (criadoPorId /
// atualizadoPorId — escalares; a trilha completa fica em audit_log), criadoEm e
// atualizadoEm. Tudo escopado por organizationId (multi-tenant).

model CategoriaVeiculo {
  id              String       @id @default(uuid())
  organizationId  String       @map("organization_id")
  nome            String
  descricao       String?
  icone           String       @default("car")
  cor             String       @default("#0ea5e9")
  ativo           Boolean      @default(true)
  criadoPorId     String?      @map("criado_por_id")
  atualizadoPorId String?      @map("atualizado_por_id")
  deletedAt       DateTime?    @map("deleted_at")
  criadoEm        DateTime     @default(now()) @map("criado_em")
  atualizadoEm    DateTime     @updatedAt @map("atualizado_em")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  veiculos        Veiculo[]

  @@unique([organizationId, nome])
  @@index([organizationId, deletedAt])
  @@map("categorias_veiculo")
}

model Veiculo {
  id               String              @id @default(uuid())
  organizationId   String              @map("organization_id")
  codigo           String
  placa            String
  renavam          String?
  chassi           String?
  marca            String?
  modelo           String?
  anoFabricacao    Int?                @map("ano_fabricacao")
  anoModelo        Int?                @map("ano_modelo")
  cor              String?
  tipo             String              @default("carro")
  combustivel      String              @default("flex")
  categoriaId      String?             @map("categoria_id")
  status           String              @default("ativo")
  kmAtual          Int                 @default(0) @map("km_atual")
  horimetroAtual   Int?                @map("horimetro_atual")
  capacidadeTanque Float?              @map("capacidade_tanque")
  motoristaId      String?             @map("motorista_id")
  responsavelId    String?             @map("responsavel_id")
  centroCusto      String?             @map("centro_custo")
  unidade          String?
  setorId          String?             @map("setor_id")
  ativoId          String?             @unique @map("ativo_id")
  dataAquisicao    DateTime?           @map("data_aquisicao")
  valorAquisicao   Float?              @map("valor_aquisicao")
  observacoes      String?             @db.Text
  descricao        String?             @db.Text
  criadoPorId      String?             @map("criado_por_id")
  atualizadoPorId  String?             @map("atualizado_por_id")
  deletedAt        DateTime?           @map("deleted_at")
  /// Identificação operacional (TR01, S02...). Migration frota_status_operacional.
  identificacao    String?
  criadoEm         DateTime            @default(now()) @map("criado_em")
  atualizadoEm     DateTime            @updatedAt @map("atualizado_em")
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoria        CategoriaVeiculo?   @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  motorista        Motorista?          @relation("VeiculoMotoristaPadrao", fields: [motoristaId], references: [id], onDelete: SetNull)
  responsavel      User?               @relation("VeiculoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  setor            Setor?              @relation(fields: [setorId], references: [id], onDelete: SetNull)
  ativo            Ativo?              @relation(fields: [ativoId], references: [id], onDelete: SetNull)
  pneus            Pneu[]
  revisoes         RevisaoVeiculo[]
  manutencoes      ManutencaoVeiculo[]
  documentos       DocumentoVeiculo[]
  abastecimentos   Abastecimento[]
  condutores       VeiculoCondutor[]
  reservas         ReservaVeiculo[]
  chamados         Chamado[]           @relation("ChamadoVeiculo")

  @@unique([organizationId, placa])
  @@unique([organizationId, codigo])
  @@index([organizationId, status])
  @@index([organizationId, deletedAt])
  @@map("veiculos")
}

model Motorista {
  id                  String                  @id @default(uuid())
  organizationId      String                  @map("organization_id")
  nome                String
  cpf                 String?
  matricula           String?
  departamento        String?
  cargo               String?
  cnh                 String?
  categoriaCnh        String?                 @map("categoria_cnh")
  cnhEmissao          DateTime?               @map("cnh_emissao")
  validadeCnh         DateTime?               @map("validade_cnh")
  orgaoEmissor        String?                 @map("orgao_emissor")
  telefone            String?
  email               String?
  userId              String?                 @map("user_id")
  status              String                  @default("ativo")
  observacoes         String?                 @db.Text
  criadoPorId         String?                 @map("criado_por_id")
  atualizadoPorId     String?                 @map("atualizado_por_id")
  deletedAt           DateTime?               @map("deleted_at")
  criadoEm            DateTime                @default(now()) @map("criado_em")
  atualizadoEm        DateTime                @updatedAt @map("atualizado_em")
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  veiculos            Veiculo[]               @relation("VeiculoMotoristaPadrao")
  abastecimentos      Abastecimento[]
  condutorAssignments VeiculoCondutor[]
  renovacoes          MotoristaCnhRenovacao[]
  anexos              MotoristaAnexo[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, status])
  @@map("motoristas")
}

model MotoristaCnhRenovacao {
  id                String       @id @default(uuid())
  organizationId    String       @map("organization_id")
  motoristaId       String       @map("motorista_id")
  numeroAnterior    String?      @map("numero_anterior")
  categoriaAnterior String?      @map("categoria_anterior")
  validadeAnterior  DateTime?    @map("validade_anterior")
  numeroNovo        String?      @map("numero_novo")
  categoriaNova     String?      @map("categoria_nova")
  validadeNova      DateTime?    @map("validade_nova")
  orgaoEmissor      String?      @map("orgao_emissor")
  dataRenovacao     DateTime     @default(now()) @map("data_renovacao")
  observacoes       String?      @db.Text
  criadoPorId       String?      @map("criado_por_id")
  criadoEm          DateTime     @default(now()) @map("criado_em")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  motorista         Motorista    @relation(fields: [motoristaId], references: [id], onDelete: Cascade)

  @@index([motoristaId, dataRenovacao])
  @@map("motorista_cnh_renovacoes")
}

model MotoristaAnexo {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  motoristaId    String       @map("motorista_id")
  tipo           String
  nomeArquivo    String       @map("nome_arquivo")
  nomeOriginal   String       @map("nome_original")
  mime           String?
  tamanho        Int?
  criadoPorId    String?      @map("criado_por_id")
  deletedAt      DateTime?    @map("deleted_at")
  criadoEm       DateTime     @default(now()) @map("criado_em")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  motorista      Motorista    @relation(fields: [motoristaId], references: [id], onDelete: Cascade)

  @@index([motoristaId, deletedAt])
  @@map("motorista_anexos")
}

model Pneu {
  id              String       @id @default(uuid())
  organizationId  String       @map("organization_id")
  veiculoId       String?      @map("veiculo_id")
  numeroFogo      String?      @map("numero_fogo")
  codigo          String?
  numeroSerie     String?      @map("numero_serie")
  marca           String?
  modelo          String?
  medida          String?
  dot             String?
  dataFabricacao  DateTime?    @map("data_fabricacao")
  fornecedor      String?
  valorCompra     Float?       @map("valor_compra")
  posicao         String?
  dataInstalacao  DateTime?    @map("data_instalacao")
  kmInstalacao    Int?         @map("km_instalacao")
  kmInicial       Int?         @map("km_inicial")
  kmAtual         Int?         @map("km_atual")
  vidaUtilKm      Int?         @map("vida_util_km")
  kmPrevisto      Int?         @map("km_previsto")
  status          String       @default("estoque")
  observacoes     String?      @db.Text
  criadoPorId     String?      @map("criado_por_id")
  atualizadoPorId String?      @map("atualizado_por_id")
  deletedAt       DateTime?    @map("deleted_at")
  criadoEm        DateTime     @default(now()) @map("criado_em")
  atualizadoEm    DateTime     @updatedAt @map("atualizado_em")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  veiculo         Veiculo?     @relation(fields: [veiculoId], references: [id], onDelete: SetNull)
  eventos         PneuEvento[]

  @@index([organizationId, deletedAt])
  @@index([veiculoId])
  @@map("pneus")
}

model PneuEvento {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  pneuId         String       @map("pneu_id")
  veiculoId      String?      @map("veiculo_id")
  tipo           String // instalacao | remocao | rodizio | recapagem | descarte
  data           DateTime     @default(now())
  km             Int?
  posicaoDe      String?      @map("posicao_de")
  posicaoPara    String?      @map("posicao_para")
  custo          Float?
  observacoes    String?      @db.Text
  criadoPorId    String?      @map("criado_por_id")
  criadoEm       DateTime     @default(now()) @map("criado_em")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pneu           Pneu         @relation(fields: [pneuId], references: [id], onDelete: Cascade)

  @@index([pneuId, data])
  @@index([organizationId, tipo])
  @@map("pneu_eventos")
}

model PneuLayout {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  tipo           String // carro | moto | caminhao | van | onibus
  posicoes       Json         @default("[]")
  criadoEm       DateTime     @default(now()) @map("criado_em")
  atualizadoEm   DateTime     @updatedAt @map("atualizado_em")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, tipo])
  @@map("pneu_layouts")
}

model RevisaoVeiculo {
  id              String       @id @default(uuid())
  organizationId  String       @map("organization_id")
  veiculoId       String       @map("veiculo_id")
  tipo            String?
  descricao       String?
  dataPrevista    DateTime?    @map("data_prevista")
  kmPrevisto      Int?         @map("km_previsto")
  dataRealizada   DateTime?    @map("data_realizada")
  kmRealizado     Int?         @map("km_realizado")
  horimetro       Int?
  status          String       @default("agendada")
  custo           Float?
  oficina         String?
  observacoes     String?      @db.Text
  criadoPorId     String?      @map("criado_por_id")
  atualizadoPorId String?      @map("atualizado_por_id")
  deletedAt       DateTime?    @map("deleted_at")
  criadoEm        DateTime     @default(now()) @map("criado_em")
  atualizadoEm    DateTime     @updatedAt @map("atualizado_em")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  veiculo         Veiculo      @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  @@index([organizationId, deletedAt])
  @@index([veiculoId])
  @@index([organizationId, status])
  @@map("revisoes_veiculo")
}

// Planos de revisão preventiva: regra por modelo + tipo, baseada em km, data ou horímetro.
model PlanoRevisao {
  id                 String       @id @default(uuid())
  organizationId     String       @map("organization_id")
  modelo             String
  marca              String?
  veiculoId          String?      @map("veiculo_id") // se preenchido, o plano vale só para este veículo (senão, por modelo)
  tipo               String // troca_oleo | filtros | correias | freios | suspensao | revisao_geral
  base               String       @default("km") // km | data | horimetro
  intervaloKm        Int?         @map("intervalo_km")
  intervaloDias      Int?         @map("intervalo_dias")
  intervaloHorimetro Int?         @map("intervalo_horimetro")
  ativo              Boolean      @default(true)
  observacoes        String?      @db.Text
  criadoPorId        String?      @map("criado_por_id")
  atualizadoPorId    String?      @map("atualizado_por_id")
  deletedAt          DateTime?    @map("deleted_at")
  criadoEm           DateTime     @default(now()) @map("criado_em")
  atualizadoEm       DateTime     @updatedAt @map("atualizado_em")
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, deletedAt])
  @@index([organizationId, modelo])
  @@map("planos_revisao")
}

model ManutencaoVeiculo {
  id                String              @id @default(uuid())
  organizationId    String              @map("organization_id")
  veiculoId         String              @map("veiculo_id")
  numeroOs          String?             @map("numero_os")
  tipo              String              @default("corretiva")
  descricao         String?
  solicitanteId     String?             @map("solicitante_id")
  data              DateTime?
  dataAgendada      DateTime?           @map("data_agendada")
  dataAbertura      DateTime?           @map("data_abertura")
  dataFechamento    DateTime?           @map("data_fechamento")
  km                Int?
  custoPecas        Float?              @map("custo_pecas")
  custoServicos     Float?              @map("custo_servicos")
  custoTerceiros    Float?              @map("custo_terceiros")
  custo             Float?
  fornecedorId      String?             @map("fornecedor_id")
  fornecedor        String?
  oficina           String?
  pecas             Json                @default("[]")
  status            String              @default("aberta")
  observacoes       String?             @db.Text
  criadoPorId       String?             @map("criado_por_id")
  atualizadoPorId   String?             @map("atualizado_por_id")
  deletedAt         DateTime?           @map("deleted_at")
  /// A OS tira o veículo de operação. Migration frota_status_operacional.
  imobiliza         Boolean             @default(true)
  localizacao       String?
  previsaoLiberacao DateTime?           @map("previsao_liberacao")
  criadoEm          DateTime            @default(now()) @map("criado_em")
  atualizadoEm      DateTime            @updatedAt @map("atualizado_em")
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  veiculo           Veiculo             @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  solicitante       User?               @relation("ManutencaoSolicitante", fields: [solicitanteId], references: [id], onDelete: SetNull)
  maoObra           ManutencaoMaoObra[]
  anexos            ManutencaoAnexo[]
  /// OS nascida de um chamado. Fechar o chamado fecha esta OS.
  chamadoId         String?             @map("chamado_id")
  chamado           Chamado?            @relation("ManutencaoChamado", fields: [chamadoId], references: [id], onDelete: SetNull)

  @@index([organizationId, deletedAt])
  @@index([veiculoId])
  @@index([organizationId, status])
  @@map("manutencoes_veiculo")
}

model ManutencaoMaoObra {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  manutencaoId   String            @map("manutencao_id")
  descricao      String
  responsavel    String?
  horas          Float?
  valorHora      Float?            @map("valor_hora")
  custo          Float?
  data           DateTime          @default(now())
  criadoPorId    String?           @map("criado_por_id")
  criadoEm       DateTime          @default(now()) @map("criado_em")
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manutencao     ManutencaoVeiculo @relation(fields: [manutencaoId], references: [id], onDelete: Cascade)

  @@index([manutencaoId])
  @@map("manutencao_mao_obra")
}

model ManutencaoAnexo {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  manutencaoId   String            @map("manutencao_id")
  tipo           String // nota_fiscal | foto | orcamento
  nomeArquivo    String            @map("nome_arquivo")
  nomeOriginal   String            @map("nome_original")
  mime           String?
  tamanho        Int?
  criadoPorId    String?           @map("criado_por_id")
  deletedAt      DateTime?         @map("deleted_at")
  criadoEm       DateTime          @default(now()) @map("criado_em")
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manutencao     ManutencaoVeiculo @relation(fields: [manutencaoId], references: [id], onDelete: Cascade)

  @@index([manutencaoId, deletedAt])
  @@map("manutencao_anexos")
