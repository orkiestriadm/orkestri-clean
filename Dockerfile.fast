FROM node:20-alpine
WORKDIR /app
RUN apk add --no-cache libc6-compat
RUN addgroup -S app && adduser -S app -G app
COPY . ./
RUN mkdir -p .next/static && mv static/* .next/static/ || true
RUN chown -R app:app /app
USER app
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1
CMD ["node", "server.js"]
